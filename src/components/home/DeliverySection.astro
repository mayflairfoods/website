---
import Container from "@/components/layout/Container.astro";

const features = [
  {
    title: "Order Anytime",
    description: "Easy online ordering",
    icon: "location",
  },
  {
    title: "Fast Delivery",
    description: "Quick delivery to your location",
    icon: "delivery",
  },
  {
    title: "Trusted Delivery Partner",
    description: "Godere",
    icon: "shield",
  },
];
---

<section class="py-12 sm:py-16 ">
  <Container>
    <div class="mx-auto max-w-6xl">

      <!-- Main Delivery Section -->
      <div class="grid gap-3 sm:gap-4 lg:grid-cols-2">

        <!-- Content Card -->
        <div
          class="relative overflow-hidden rounded-3xl p-6 sm:rounded-4xl sm:p-10 h-full  lg:p-12"
        >
          <!-- Background -->
          <img
            src="/images/home/hero-bg.webp"
            alt=""
            aria-hidden="true"
            class="pointer-events-none absolute inset-0 h-full w-full object-cover bottom-0 top-0"
          />

          <!-- Content -->
          <div class="relative z-10 flex h-full flex-col">

            <!-- Badge -->
            <div
              class="inline-flex w-fit items-center gap-2 rounded-full border border-primary/70 px-3 py-2 text-[10px] font-medium tracking-wide text-primary sm:px-4 sm:text-xs"
            >
              <img
                src="/icons/home/bike.svg"
                alt=""
                aria-hidden="true"
                class="h-4 w-4"
              />

              <span>QUICK DELIVERY</span>
            </div>

            <!-- Heading -->
            <div class="mt-6 sm:mt-7">
              <h2
                class="text-3xl font-medium leading-[1.05] tracking-tight text-foreground sm:text-4xl lg:text-5xl"
              >
                Skip the queue

                <span class="block text-primary">
                  Let's come to you
                </span>
              </h2>

              <p
                class="mt-5 max-w-lg text-sm leading-relaxed text-muted sm:mt-6 sm:text-base lg:text-lg"
              >
                Whether you're at home, on campus, or at the office,
                we'll bring your favorites right to your doorstep,
                fresh, fast, and ready to enjoy.
              </p>
            </div>

            <!-- Actions -->
            <div class="mt-8 flex flex-wrap items-end gap-2 sm:mt-auto sm:pt-10 sm:gap-4">

              <a
                href="https://wa.link/cpo8so"
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex py-2 font-display items-center justify-center rounded-full bg-accent px-4 text-base font-medium text-[#584013] transition-all duration-300 hover:-translate-y-0.5 hover:bg-accent-dark sm:min-h-12 sm:px-6"
              >
                Order Now
              </a>

              <!-- Coming Soon -->
              <div class="relative pt-5">
                <span
                  class="absolute left-1/2 top-0 -z-10 -translate-x-1/2 whitespace-nowrap rounded-full bg-primary px-3 py-1 text-[9px] font-semibold tracking-wide text-white sm:text-[10px]"
                >
                  COMING SOON
                </span>

                <button
                  type="button"
                  disabled
                  class="inline-flex py-2 font-display items-center justify-center rounded-full border border-primary/70 bg-white px-4 text-base font-medium text-primary sm:min-h-12 sm:px-6"
                >
                  Track your order
                </button>
              </div>

            </div>
          </div>
        </div>

        <!-- Delivery Image -->
        <div
          class="relative min-h-80 overflow-hidden rounded-3xl sm:min-h-105 sm:rounded-4xl lg:min-h-full"
        >
          <img
            src="/images/home/delivery.webp"
            alt="Mayflair delivery rider handing an order to a customer"
            class="absolute inset-0 h-full w-full object-cover transition-transform duration-700 hover:scale-[1.03]"
            loading="lazy"
          />
        </div>

      </div>

      <!-- Features -->
      <div
        class="mt-3 grid overflow-hidden rounded-3xl bg-surface-muted sm:mt-4 sm:grid-cols-3 sm:rounded-4xl"
      >
        {
          features.map((feature, index) => (
            <div
              class:list={[
                "flex items-center gap-4 px-5 py-5 sm:px-6 sm:py-6 lg:px-8",
                index < features.length - 1 &&
                  "border-b border-border sm:border-b-0 sm:border-r",
              ]}
            >
              <!-- Icon -->
              <div
                class="flex h-11 w-11 shrink-0 items-center justify-center rounded-full bg-primary/10 sm:h-12 sm:w-12"
              >
                {
                  feature.icon === "location" && (
                    <img
                      src="/icons/home/location.svg"
                      alt=""
                      aria-hidden="true"
                      class="h-5 w-5"
                    />
                  )
                }

                {
                  feature.icon === "delivery" && (
                    <img
                      src="/icons/home/bike.svg"
                      alt=""
                      aria-hidden="true"
                      class="h-5 w-5"
                    />
                  )
                }

                {
                  feature.icon === "shield" && (
                    <img
                      src="/icons/home/shield-tick.svg"
                      alt=""
                      aria-hidden="true"
                      class="h-5 w-5"
                    />
                  )
                }
              </div>

              <div class="min-w-0">
                <h3 class="text-sm font-semibold text-foreground">
                  {feature.title}
                </h3>

                <p class="mt-1 text-sm text-muted">
                  {feature.description}
                </p>
              </div>
            </div>
          ))
        }
      </div>

    </div>
  </Container>
</section>