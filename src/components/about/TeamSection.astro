---
import Container from "@/components/layout/Container.astro";

const team = [
  {
    name: "Adams Smith",
    role: "Chef",
    image: "/images/team/adams-smith.jpg",
  },
  {
    name: "Emmanuel Christopher",
    role: "CTO",
    image: "/images/team/emmanuel-christopher.jpg",
  },
  {
    name: "Adanna Ezeoke",
    role: "Brand Manager",
    image: "/images/team/adanna-ezeoke.jpg",
  },
];
---

<section class="bg-[#fff8f8] py-16 sm:py-20 lg:py-24">
  <Container>
    <div class="mx-auto max-w-2xl text-center">
      <h2 class="text-2xl font-semibold tracking-tight sm:text-3xl">
        Meet the people behind Mayflair
      </h2>

      <p class="mt-3 text-sm leading-6 text-muted">
        The people behind every meal, every order, and every warm welcome.
      </p>
    </div>

    <div class="mx-auto mt-10 grid max-w-3xl grid-cols-1 gap-5 sm:grid-cols-3">
      {
        team.map((person) => (
          <article class="text-center">
            <div class="overflow-hidden rounded-xl">
              <img
                src={person.image}
                alt={person.name}
                loading="lazy"
                class="aspect-square w-full object-cover"
              />
            </div>

            <h3 class="mt-3 text-xs font-semibold text-foreground">
              {person.name}
            </h3>

            <p class="mt-1 text-xs text-muted">{person.role}</p>
          </article>
        ))
      }
    </div>
  </Container>
</section>
