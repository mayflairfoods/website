---
import GalleryBox from "../shared/GalleryBox";
---

<section class="overflow-hidden bg-white py-16 sm:py-20 lg:py-24">
  {/* Heading */}
  <div class="mx-auto max-w-6xl px-5 text-center sm:px-6 lg:px-8">
    <h2
      class="text-3xl font-medium tracking-tight text-foreground md:text-[2.75rem]"
    >
      Life at Mayflair
    </h2>

    <p
      class="mx-auto mt-3 max-w-xl text-sm leading-relaxed text-muted sm:text-base"
    >
      A little look into the food, people, moments and experiences that make
      Mayflair what it is.
    </p>
  </div>

  <GalleryBox />
</section>
