---
import Container from "@/components/layout/Container.astro";
---

<section class="relative overflow-hidden bg-[#fff8f8] py-20 sm:py-24 lg:py-28">
  <div
    class="pointer-events-none absolute -left-24 top-10 h-72 w-72 rounded-full bg-primary/5 blur-3xl"
    aria-hidden="true"
  >
  </div>

  <div
    class="pointer-events-none absolute -right-24 bottom-0 h-80 w-80 rounded-full bg-[#f6c8c8]/30 blur-3xl"
    aria-hidden="true"
  >
  </div>

  <Container>
    <div class="relative mx-auto max-w-4xl text-center">
      <h2
        class="text-3xl font-medium tracking-tight sm:text-4xl lg:text-[3.5rem]"
      >
        Ready to be part of the team?
      </h2>

      <p class="mx-auto mt-4 max-w-xl leading-6 text-muted">
        Whether you're passionate about cooking, customer service, or
        creativity, we'd love to meet you.
      </p>

      <a
        href="/careers"
        class="mt-6 inline-flex items-center font-display justify-center rounded-full bg-[#f6b51b] px-8 py-4 font-semibold text-[#5a2b00] transition hover:-translate-y-0.5 hover:shadow-md"
      >
        View open roles
      </a>
    </div>
  </Container>
</section>
