---
import Container from "@/components/layout/Container.astro";

const values = [
  {
    title: "Excellence",
    description: "We take pride in doing everything well, no matter how small.",
    icon: "medal-star.svg",
  },
  {
    title: "Hospitality",
    description: "Every customer should feel genuinely welcomed and cared for.",
    icon: "heart-tick.svg",
  },
  {
    title: "Community",
    description: "We're stronger by supporting each other and those around us.",
    icon: "people.svg",
  },
  {
    title: "Innovation",
    description: "We stay curious and always look for better ways to serve.",
    icon: "designtools.svg",
  },
  {
    title: "Integrity",
    description: "We do the right thing, even when no one is watching.",
    icon: "tick-circle.svg",
  },
];
---

<section class="bg-[#fff5f5] py-16 sm:py-20 lg:py-24">
  <Container>
    <div class="mx-auto max-w-2xl text-center">
      <h2
        class="text-center text-3xl md:text-[2.75rem] tracking-tight font-medium"
      >
        The values you'll see every day
      </h2>

      <p class="mt-3 leading-6 text-muted">
        These principles guide how we treat our customers, support our
        teammates, and show up every single day.
      </p>
    </div>

    <div class="mx-auto mt-10 max-w-xl space-y-2">
      {
        values.map((value) => (
          <div class="flex items-start gap-4 rounded-xl bg-white px-5 py-4 shadow-sm">
            <div class="flex h-13 w-13 shrink-0 items-center justify-center rounded-full bg-primary-soft">
              <img
                src={`/icons/about/${value.icon}`}
                alt=""
                class="w-6 h-6 aspect-square object-contain"
              />
            </div>

            <div>
              <h3 class="text-lg font-display font-semibold text-foreground">
                {value.title}
              </h3>

              <p class="mt-1 leading-5 text-muted">{value.description}</p>
            </div>
          </div>
        ))
      }
    </div>
  </Container>
</section>
