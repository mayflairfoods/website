---
import Container from "@/components/layout/Container.astro";

const highlights = [
  {
    icon: "⚡",
    title: "Fast Delivery",
    description:
      "Hot, fresh, and on time. We make sure your cravings get to you fast.",
  },
  {
    icon: "☕",
    title: "Friendly Service",
    description:
      "From first hello to the last bite, we're here to serve you with warmth.",
  },
  {
    icon: "🎓",
    title: "Campus Favorite",
    description: "Loved by students, trusted by many, and part of campus life.",
  },
  {
    icon: "♥",
    title: "Community Oriented",
    description: "Loved by our community and proud to be part of campus life.",
  },
];
---

<section class="bg-[#fff5f5] py-16 sm:py-20 lg:py-24">
  <Container>
    <div class="text-center">
      <h2 class="text-2xl font-semibold tracking-tight sm:text-3xl">
        The little things people
        <span class="relative"> love about us </span>
      </h2>
    </div>

    <div class="mx-auto mt-12 grid max-w-5xl grid-cols-2 gap-8 md:grid-cols-4">
      {
        highlights.map((item) => (
          <article class="text-center">
            <div class="mx-auto flex h-16 w-16 items-center justify-center rounded-full bg-white text-2xl shadow-sm">
              {item.icon}
            </div>

            <h3 class="mt-5 text-sm font-semibold text-foreground">
              {item.title}
            </h3>

            <p class="mt-2 text-xs leading-5 text-muted">{item.description}</p>
          </article>
        ))
      }
    </div>
  </Container>
</section>
