---
import MobileMenu from "@/components/ui/MobileMenu";
import type { NavItem } from "@/types/navigation";

const navItems: NavItem[] = [
  { label: "Home", href: "/" },
  { label: "About", href: "/about" },
  { label: "Contact Us", href: "/contact" },
  { label: "Blog", href: "/blog" },
  { label: "Inside MayFlair", href: "/inside", badge: "New" },
];
---

<header class="site-header">
  <div
    class="mx-auto flex h-14 items-center justify-between rounded-full bg-white px-4 shadow-[0_4px_18px_rgba(181,18,43,0.08)] sm:h-16"
  >
    <!-- Logo -->
    <a href="/" aria-label="Mayflair Foods home" class="shrink-0">
      <!-- Desktop -->
      <span class="hidden md:block">
        <img
          src="/images/MAYFLAIR_LOGO.svg"
          alt="Mayflair Foods"
          width="102"
          height="96"
          class="h-10 w-auto object-contain"
        />
      </span>

      <!-- Mobile -->
      <span class="block md:hidden">
        <img
          src="/images/DP.svg"
          alt="Mayflair Foods"
          width="48"
          height="48"
          class="h-7 w-7 object-contain"
        />
      </span>
    </a>

    <!-- Desktop Navigation -->
    <nav
      class="hidden items-center gap-4 md:flex lg:gap-6"
      aria-label="Main navigation"
    >
      {
        navItems.map((item) => (
          <a
            href={item.href}
            class="inline-flex items-center gap-1.5 px-1 font-medium text-foreground transition-colors hover:text-primary"
          >
            {item.label}
            {item.badge && (
              <span class="rounded-full bg-primary px-1.5 py-0.5 text-[0.625rem] leading-none font-bold tracking-wide text-white uppercase">
                {item.badge}
              </span>
            )}
          </a>
        ))
      }
    </nav>

    <!-- Desktop CTA -->
    <a
      href="/"
      class="hidden h-max shrink-0 items-center justify-center rounded-full px-6 py-3 font-semibold text-[#513300] font-display bg-[#F1AC34] transition-colors hover:bg-accent-dark md:inline-flex"
    >
      Order Now
    </a>

    <!-- Mobile Menu -->
    <div class="md:hidden">
      <MobileMenu items={navItems} client:load />
    </div>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    padding-top: 1rem;
    background: rgba(255, 255, 255, 0.94);
  }
</style>
