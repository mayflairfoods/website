---
import Container from "./Container.astro";
import MobileMenu from "@/components/ui/MobileMenu";
import type { NavItem } from "@/types/navigation";

const navItems: NavItem[] = [
  { label: "Home", href: "/" },
  { label: "About", href: "/about" },
  { label: "Contact Us", href: "/contact" },
  { label: "Blog", href: "/blog" },
];
---

<header class="sticky top-0 z-50 w-full px-3 pt-3 sm:px-5 sm:pt-5">
  <div
    class="mx-auto flex h-14 items-center justify-between rounded-full bg-white px-4 shadow-[0_6px_24px_rgba(181,18,43,0.08)] sm:h-16"
  >
    <!-- Logo -->
    <a href="/" aria-label="Mayflair Foods home" class="shrink-0">
      <!-- Desktop -->
      <span class="hidden md:block">
        <img
          src="/images/MAYFLAIR_LOGO.svg"
          alt="Mayflair Foods"
          width="102"
          height="96"
          class="h-10 w-auto object-contain"
        />
      </span>

      <!-- Mobile -->
      <span class="block md:hidden">
        <img
          src="/images/DP.svg"
          alt="Mayflair Foods"
          width="48"
          height="48"
          class="h-7 w-7 object-contain"
        />
      </span>
    </a>

    <!-- Desktop Navigation -->
    <nav class="hidden items-center gap-6 md:flex" aria-label="Main navigation">
      {
        navItems.map((item) => (
          <a
            href={item.href}
            class="font-medium text-foreground transition-colors hover:text-primary px-1"
          >
            {item.label}
          </a>
        ))
      }
    </nav>

    <!-- Desktop CTA -->
    <a
      href="/"
      class="hidden h-max shrink-0 items-center justify-center rounded-full px-6 py-3 font-semibold text-[#513300] font-display bg-[#F1AC34] transition-colors hover:bg-accent-dark md:inline-flex"
    >
      Order Now
    </a>

    <!-- Mobile Menu -->
    <div class="md:hidden">
      <MobileMenu items={navItems} client:load />
    </div>
  </div>
</header>
