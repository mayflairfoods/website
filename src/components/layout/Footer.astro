---
import Container from "./Container.astro";
import { site } from "@/data/site";

const currentYear = new Date().getFullYear();
const { quickLinks, social: socialLinks, contact } = site;
---

<footer class="overflow-hidden bg-primary pt-10 text-white sm:pt-32 lg:pt-36">
  <div class="border-b border-white/10">
    <div class="py-10 px-4 sm:px-6 lg:px-8 sm:py-12 lg:py-14">
      <div
        class="grid gap-10 sm:grid-cols-2 lg:grid-cols-[2fr_1fr_1fr] lg:gap-12"
      >
        <!-- Brand + Newsletter -->
        <div class="min-w-0">
          <a href="/" aria-label="Mayflair Foods home" class="inline-flex">
            <img
              src="/images/mayflair-logo-white.svg"
              alt="Mayflair Foods"
              width="90"
              height="50"
              class="h-auto w-19 sm:w-20"
            />
          </a>

          <!-- Newsletter -->
          <div class="mt-4">
            <form
              id="newsletter-form"
              class="mt-2 flex w-full min-w-0 max-w-md items-center rounded-full bg-white/10"
            >
              <label for="newsletter-email" class="sr-only">
                Your email address
              </label>

              <input
                id="newsletter-email"
                name="email"
                type="email"
                placeholder="yourname@email.com"
                autocomplete="email"
                required
                class="min-w-0 flex-1 bg-transparent px-3 py-2.5 text-xs text-white outline-none placeholder:text-white/50"
              />

              <button
                type="submit"
                class="shrink-0 rounded-full font-display bg-accent px-5 py-2.5 text-xs font-semibold text-foreground transition-colors hover:bg-accent-dark disabled:cursor-not-allowed disabled:opacity-60"
              >
                Subscribe
              </button>
            </form>

            <p
              id="newsletter-status"
              class="mt-2 hidden text-xs"
              role="status"
              aria-live="polite"
            >
            </p>
            <p class="mt-2 text-sm ml-2 font-display text-accent">
              Good food, always.
            </p>
          </div>
        </div>

        <!-- Quick Links -->
        <div class="min-w-0">
          <h2 class="text-xs font-bold uppercase tracking-wide">Quick Links</h2>

          <nav class="mt-4 flex flex-col gap-2" aria-label="Footer navigation">
            {
              quickLinks.map((link) => (
                <a
                  href={link.href}
                  class="w-fit max-w-full text-sm leading-relaxed text-white/80 transition-colors hover:text-white"
                >
                  {link.label}
                </a>
              ))
            }
          </nav>
        </div>

        <!-- Contact -->
        <div class="min-w-0">
          <h2 class="text-xs font-bold uppercase tracking-wide">Contact</h2>

          <div class="mt-4 flex flex-col gap-2">
            <a
              href={`mailto:${contact.email}`}
              class="flex min-w-0 items-center gap-2 text-sm text-white/80 transition-colors hover:text-white"
            >
              <span
                class="flex h-4 w-4 shrink-0 items-center justify-center"
                aria-hidden="true"
              >
                <img src="/icons/messages.svg" alt="" class="h-4 w-4" />
              </span>

              <span class="truncate">
                {contact.email}
              </span>
            </a>

            <a
              href={contact.phoneHref}
              class="flex items-center gap-2 text-sm text-white/80 transition-colors hover:text-white"
            >
              <span
                class="flex h-4 w-4 shrink-0 items-center justify-center"
                aria-hidden="true"
              >
                <img
                  src="/icons/call-calling-white.svg"
                  alt=""
                  class="h-4 w-4"
                />
              </span>

              <span>{contact.phone}</span>
            </a>
          </div>

          <!-- Socials -->
          <nav class="mt-5 flex items-center gap-2" aria-label="Social media">
            {
              socialLinks.map((social) => (
                <a
                  href={social.href}
                  target="_blank"
                  rel="noopener noreferrer"
                  aria-label={`Follow Mayflair Foods on ${social.label}`}
                  class="flex h-8 w-8 items-center justify-center rounded-full bg-white transition-transform duration-200 hover:scale-105"
                >
                  <img
                    src={social.icon}
                    alt=""
                    aria-hidden="true"
                    class="h-4 w-4"
                  />
                </a>
              ))
            }
          </nav>
        </div>
      </div>
    </div>
  </div>

  <!-- Wordmark -->
  <div class="overflow-hidden px-2 pt-8 sm:px-4 sm:pt-10 lg:px-6 lg:pt-12">
    <img
      src="/images/mayflair-foods-footer.svg"
      alt=""
      aria-hidden="true"
      class="mx-auto block w-full max-w-300"
    />
  </div>

  <!-- Copyright -->
  <Container class="pb-4 pt-2 sm:pt-3">
    <p class="text-center text-[10px] text-white/70 sm:text-xs">
      © Mayflair {currentYear}. All Rights Reserved
    </p>
  </Container>
</footer>
