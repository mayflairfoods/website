---
import Container from "./Container.astro";

const currentYear = new Date().getFullYear();

const quickLinks = [
  { label: "About Us", href: "/about" },
  { label: "What's Happening in Mayflair", href: "/blog" },
  { label: "FAQ", href: "/faq" },
];

const businessLinks = [
  { label: "Catering", href: "/catering" },
  { label: "Events", href: "/events" },
  { label: "Corporate", href: "/corporate" },
  { label: "Partnership", href: "/partnership" },
  { label: "Privacy Policy", href: "/privacy" },
];

const socialLinks = [
  {
    label: "Instagram",
    href: "https://instagram.com/mayflairfoods",
  },
  {
    label: "TikTok",
    href: "https://tiktok.com/@mayflairfoods",
  },
  {
    label: "Facebook",
    href: "https://facebook.com/mayflairfoods",
  },
];
---

<footer class="bg-primary text-white">
  <!-- Main Footer -->
  <div class="border-b border-white/10">
    <Container class="py-12 sm:py-14 lg:py-16">
      <div class="grid gap-10 sm:grid-cols-2 lg:grid-cols-5 lg:gap-8">
        <!-- Brand -->
        <div>
          <a href="/" aria-label="Mayflair Foods home" class="inline-flex">
            <img
              src="/images/mayflair-logo-white.svg"
              alt="Mayflair Foods"
              width="90"
              height="50"
              class="h-auto w-20"
            />
          </a>

          <p class="mt-1 text-sm text-white/70">Good food. Always.</p>

          <!-- Newsletter -->
          <div class="mt-8">
            <p class="text-base font-semibold">Cool stuff only</p>

            <p class="mt-1 text-xs text-white/60">
              Subscribe to our newsletter
            </p>

            <form
              class="mt-4 flex w-full min-w-0 flex-col gap-2 sm:flex-row sm:items-center sm:rounded-full sm:bg-white/10 sm:p-1"
            >
              <label for="newsletter-email" class="sr-only">
                Your email address
              </label>

              <input
                id="newsletter-email"
                name="email"
                type="email"
                placeholder="you@example.com"
                autocomplete="email"
                required
                class="min-w-0 w-full rounded-full bg-white/10 px-4 py-3 text-sm text-white outline-none placeholder:text-white/40 sm:flex-1 sm:bg-transparent sm:px-3 sm:py-2"
              />

              <button
                type="submit"
                class="w-full shrink-0 whitespace-nowrap rounded-full bg-accent px-5 py-3 text-sm font-semibold text-white transition-colors hover:bg-accent-dark sm:w-auto sm:py-2"
              >
                Subscribe
              </button>
            </form>
          </div>
        </div>

        <!-- Opening Hours -->
        <div>
          <h2 class="text-sm font-semibold uppercase tracking-wide">
            Opening Hours
          </h2>

          <div class="mt-4 space-y-2 text-sm leading-relaxed text-white/70">
            <p>Monday - Friday · 9 AM - 9 PM</p>
            <p>Saturday · 9 AM - 11 PM</p>
            <p>Sunday · Closed</p>
          </div>
        </div>

        <!-- Quick Links -->
        <div>
          <h2 class="text-sm font-semibold uppercase tracking-wide">
            Quick Links
          </h2>

          <nav
            class="mt-4 flex flex-col gap-2.5"
            aria-label="Footer navigation"
          >
            {
              quickLinks.map((link) => (
                <a
                  href={link.href}
                  class="w-fit text-sm text-white/70 transition-colors hover:text-white"
                >
                  {link.label}
                </a>
              ))
            }
          </nav>
        </div>

        <!-- Business -->
        <div>
          <h2 class="text-sm font-semibold uppercase tracking-wide">
            Business
          </h2>

          <nav
            class="mt-4 flex flex-col gap-2.5"
            aria-label="Business navigation"
          >
            {
              businessLinks.map((link) => (
                <a
                  href={link.href}
                  class="w-fit text-sm text-white/70 transition-colors hover:text-white"
                >
                  {link.label}
                </a>
              ))
            }
          </nav>
        </div>

        <!-- Contact -->
        <div>
          <h2 class="text-sm font-semibold uppercase tracking-wide">Contact</h2>

          <div class="mt-4 flex flex-col gap-2.5">
            <a
              href="mailto:hello@mayflairfoods.com"
              class="w-fit text-sm text-white/70 transition-colors hover:text-white"
            >
              hello@mayflairfoods.com
            </a>

            <a
              href="tel:+2348123456789"
              class="w-fit text-sm text-white/70 transition-colors hover:text-white"
            >
              +234 812 345 6789
            </a>
          </div>

          <div class="mt-5 flex items-center gap-2">
            {
              socialLinks.map((social) => (
                <a
                  href={social.href}
                  target="_blank"
                  rel="noopener noreferrer"
                  aria-label={social.label}
                  class="flex h-8 w-8 items-center justify-center rounded-full border border-white/25 text-xs font-semibold text-white transition-colors hover:border-white hover:bg-white/10"
                >
                  {social.label.charAt(0)}
                </a>
              ))
            }
          </div>
        </div>
      </div>
    </Container>
  </div>

  <!-- Large Footer Wordmark -->
  <div class="overflow-hidden px-3 pt-8 sm:px-6 sm:pt-10 lg:px-8 lg:pt-12">
    <img
      src="/images/mayflair-foods-footer.svg"
      alt=""
      aria-hidden="true"
      class="mx-auto w-full max-w-[1200px]"
    />
  </div>

  <!-- Copyright -->
  <Container class="pb-4 pt-2">
    <p class="text-center text-xs text-white/50">
      © {currentYear} Mayflair Foods. All rights reserved.
    </p>
  </Container>
</footer>
