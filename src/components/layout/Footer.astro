---
import Container from "./Container.astro";

const currentYear = new Date().getFullYear();

const quickLinks = [
  { label: "About Us", href: "/about" },
  { label: "What's happening in Mayflair", href: "/blog" },
  { label: "FAQ", href: "/faq" },
  { label: "Career", href: "/careers" },
  { label: "Terms of Service", href: "/terms" },
  { label: "Privacy Policy", href: "/privacy" },
];

const socialLinks = [
  {
    label: "Instagram",
    href: "https://instagram.com/mayflairfoods",
    icon: "/icons/instagram.svg",
  },
  {
    label: "TikTok",
    href: "https://tiktok.com/@mayflairfoods",
    icon: "/icons/tiktok.svg",
  },
  {
    label: "Facebook",
    href: "https://facebook.com/mayflairfoods",
    icon: "/icons/facebook.svg",
  },
];

const contact = {
  email: "info@mayflairfoods.ng",
  phone: "08012345678",
  phoneHref: "tel:+2348012345678",
};

const headOffice = "40, Oseni Salawu Street, Egan Igando, Lagos.";
---

<div class="relative">
  <!-- =====================================================
       CTA
  ====================================================== -->
  <section
    class="relative z-10 mx-auto -mb-15 w-full max-w-[1280px] px-4 sm:-mb-17.5 sm:px-6 lg:px-8 mt-20"
  >
    <div
      class="relative overflow-hidden rounded-4xl bg-accent px-6 py-10 text-center sm:px-10 sm:py-12 lg:px-16 lg:py-14"
    >
      <!-- Background decoration -->
      <div
        class="pointer-events-none absolute inset-0 overflow-hidden"
        aria-hidden="true"
      >
        <div
          class="absolute -left-24 -top-32 h-80 w-80 rounded-full bg-white/10"
        >
        </div>

        <div
          class="absolute -bottom-36 -right-24 h-96 w-96 rounded-full bg-primary/10"
        >
        </div>

        <div
          class="absolute -top-25 left-[25%] h-64 w-64 rounded-full bg-white/5"
        >
        </div>
      </div>

      <!-- Left decoration -->
      <img
        src="/images/cta/left.webp"
        alt=""
        aria-hidden="true"
        class="pointer-events-none absolute -left-8 top-1/2 hidden w-24 -translate-y-1/2 sm:block lg:-left-4 lg:w-32"
      />

      <!-- Right decoration -->
      <img
        src="/images/cta/right.webp"
        alt=""
        aria-hidden="true"
        class="pointer-events-none absolute -right-8 top-1/2 hidden w-28 -translate-y-1/2 sm:block lg:-right-4 lg:w-36"
      />

      <div class="relative z-10 mx-auto w-[80%] md:w-full max-w-3xl">
        <h2
          class="text-4xl leading-tight tracking-tight text-foreground sm:text-5xl lg:text-[3.5rem]"
        >
          Are you on the go?
        </h2>

        <p
          class="mx-auto mt-3 max-w-2xl text-lg leading-relaxed text-foreground/80"
        >
          Order your favourites for pickup or delivery, we'll take care of the
          rest.
        </p>

        <a
          href="https://wa.link/cpo8so"
          target="_blank"
          rel="noopener noreferrer"
          class="mt-6 inline-flex min-h-10 items-center justify-center rounded-full bg-primary px-8 py-4 font-semibold text-white! font-display transition-all duration-200 hover:-translate-y-0.5 hover:bg-primary-dark"
        >
          Order Now
        </a>
      </div>
    </div>
  </section>

  <!-- =====================================================
       FOOTER
  ====================================================== -->
  <footer class="overflow-hidden bg-primary pt-24 text-white sm:pt-32 lg:pt-36">
    <div class="border-b border-white/10">
      <Container class="py-10 sm:py-12 lg:py-14">
        <div
          class="grid gap-10 sm:grid-cols-2 lg:grid-cols-[2fr_1fr_1fr] lg:gap-12"
        >
          <!-- Brand + Newsletter -->
          <div class="min-w-0">
            <a href="/" aria-label="Mayflair Foods home" class="inline-flex">
              <img
                src="/images/mayflair-logo-white.svg"
                alt="Mayflair Foods"
                width="90"
                height="50"
                class="h-auto w-19 sm:w-20"
              />
            </a>

            <!-- <p class="mt-1 text-sm text-white/80">Good food, always</p> -->
            <!-- Newsletter -->
            <div class="mt-4">
              <form
                id="newsletter-form"
                class="mt-2 flex w-full min-w-0 max-w-md items-center rounded-full bg-white/10"
              >
                <label for="newsletter-email" class="sr-only">
                  Your email address
                </label>

                <input
                  id="newsletter-email"
                  name="email"
                  type="email"
                  placeholder="yourname@email.com"
                  autocomplete="email"
                  required
                  class="min-w-0 flex-1 bg-transparent px-3 py-2.5 text-xs text-white outline-none placeholder:text-white/50"
                />

                <button
                  type="submit"
                  class="shrink-0 rounded-full font-display bg-accent px-5 py-2.5 text-xs font-semibold text-foreground transition-colors hover:bg-accent-dark disabled:cursor-not-allowed disabled:opacity-60"
                >
                  Subscribe
                </button>
              </form>

              <p
                id="newsletter-status"
                class="mt-2 hidden text-xs"
                role="status"
                aria-live="polite"
              >
              </p>
              <p class="mt-2 text-sm ml-2 font-display text-accent">
                Good food, always.
              </p>
            </div>
          </div>

          <!-- Quick Links -->
          <div class="min-w-0">
            <h2 class="text-xs font-bold uppercase tracking-wide">
              Quick Links
            </h2>

            <nav
              class="mt-4 flex flex-col gap-2"
              aria-label="Footer navigation"
            >
              {
                quickLinks.map((link) => (
                  <a
                    href={link.href}
                    class="w-fit max-w-full text-sm leading-relaxed text-white/80 transition-colors hover:text-white"
                  >
                    {link.label}
                  </a>
                ))
              }
            </nav>
          </div>

          <!-- Contact -->
          <div class="min-w-0">
            <h2 class="text-xs font-bold uppercase tracking-wide">Contact</h2>

            <div class="mt-4 flex flex-col gap-2">
              <a
                href={`mailto:${contact.email}`}
                class="flex min-w-0 items-center gap-2 text-sm text-white/80 transition-colors hover:text-white"
              >
                <span
                  class="flex h-4 w-4 shrink-0 items-center justify-center"
                  aria-hidden="true"
                >
                  <img src="/icons/messages.svg" alt="" class="h-4 w-4" />
                </span>

                <span class="truncate">
                  {contact.email}
                </span>
              </a>

              <a
                href={contact.phoneHref}
                class="flex items-center gap-2 text-sm text-white/80 transition-colors hover:text-white"
              >
                <span
                  class="flex h-4 w-4 shrink-0 items-center justify-center"
                  aria-hidden="true"
                >
                  <img
                    src="/icons/call-calling-white.svg"
                    alt=""
                    class="h-4 w-4"
                  />
                </span>

                <span>{contact.phone}</span>
              </a>
            </div>

            <!-- Socials -->
            <nav class="mt-5 flex items-center gap-2" aria-label="Social media">
              {
                socialLinks.map((social) => (
                  <a
                    href={social.href}
                    target="_blank"
                    rel="noopener noreferrer"
                    aria-label={`Follow Mayflair Foods on ${social.label}`}
                    class="flex h-8 w-8 items-center justify-center rounded-full bg-white transition-transform duration-200 hover:scale-105"
                  >
                    <img
                      src={social.icon}
                      alt=""
                      aria-hidden="true"
                      class="h-4 w-4"
                    />
                  </a>
                ))
              }
            </nav>
          </div>
        </div>
      </Container>
    </div>

    <!-- Wordmark -->
    <div class="overflow-hidden px-2 pt-8 sm:px-4 sm:pt-10 lg:px-6 lg:pt-12">
      <img
        src="/images/mayflair-foods-footer.svg"
        alt=""
        aria-hidden="true"
        class="mx-auto block w-full max-w-300"
      />
    </div>

    <!-- Copyright -->
    <Container class="pb-4 pt-2 sm:pt-3">
      <p class="text-center text-[10px] text-white/70 sm:text-xs">
        © Mayflair {currentYear}. All Rights Reserved
      </p>
    </Container>
  </footer>
</div>
