---
import Container from "./Container.astro";

const currentYear = new Date().getFullYear();

const quickLinks = [
  { label: "About Us", href: "/about" },
  { label: "What's happening in Mayflair", href: "/blog" },
  { label: "FAQ", href: "/faq" },
  { label: "Career", href: "/careers" },
  { label: "Terms of Service", href: "/terms" },
  { label: "Privacy Policy", href: "/privacy" },
];

const socialLinks = [
  {
    label: "Instagram",
    href: "https://instagram.com/mayflairfoods",
    icon: "instagram",
  },
  {
    label: "TikTok",
    href: "https://tiktok.com/@mayflairfoods",
    icon: "tiktok",
  },
  {
    label: "Facebook",
    href: "https://facebook.com/mayflairfoods",
    icon: "facebook",
  },
];
---

<div class="relative">
  <section
    class="relative z-10 mx-auto -mb-15 w-full max-w-[1280px] px-4 sm:-mb-17.5 sm:px-6 lg:px-8"
  >
    <div
      class="relative overflow-hidden rounded-4xl bg-accent px-6 py-10 text-center sm:px-10 sm:py-12 lg:px-16 lg:py-14"
    >

      <!-- Decorative background shapes -->
      <div
        class="pointer-events-none absolute inset-0 overflow-hidden"
        aria-hidden="true"
      >
        <div
          class="absolute -left-24 -top-32 h-80 w-80 rounded-full bg-white/10"
        ></div>

        <div
          class="absolute -right-24 -bottom-36 h-96 w-96 rounded-full bg-primary/10"
        ></div>

        <div
          class="absolute left-[25%] top-[-100px] h-64 w-64 rounded-full bg-white/5"
        ></div>
      </div>

      <!-- Left food decoration -->
      <div
        class="pointer-events-none absolute left-0 top-0 hidden h-full w-[150px] sm:block lg:w-[190px]"
        aria-hidden="true"
      >
        <!-- Replace with your actual CTA food images -->
        <img
          src="/images/cta/ice-cream.png"
          alt=""
          class="absolute -left-8 -top-8 w-28 lg:w-36"
        />

        <img
          src="/images/cta/fries.png"
          alt=""
          class="absolute -left-5 top-20 w-24 lg:w-32"
        />

        <img
          src="/images/cta/shawarma.png"
          alt=""
          class="absolute -left-5 bottom-4 w-28 lg:w-36"
        />
      </div>

      <!-- Right food decoration -->
      <div
        class="pointer-events-none absolute right-0 top-0 hidden h-full w-[150px] sm:block lg:w-[190px]"
        aria-hidden="true"
      >
        <img
          src="/images/cta/bread.png"
          alt=""
          class="absolute -right-4 -top-8 w-28 lg:w-36"
        />

        <img
          src="/images/cta/noodles.png"
          alt=""
          class="absolute -right-5 top-20 w-32 lg:w-40"
        />

        <img
          src="/images/cta/burger.png"
          alt=""
          class="absolute -right-5 bottom-[-15px] w-32 lg:w-40"
        />
      </div>

      <!-- CTA Content -->
      <div class="relative z-10 mx-auto max-w-3xl">

        <h2
          class="text-3xl font-medium leading-tight tracking-tight text-foreground sm:text-4xl lg:text-5xl"
        >
          Are you on the go?
        </h2>

        <p
          class="mx-auto mt-3 max-w-2xl text-sm leading-relaxed text-foreground/80 sm:text-base"
        >
          Order your favourites for pickup or delivery, we'll take care of the rest.
        </p>

        <a
          href="/order"
          class="mt-6 inline-flex items-center justify-center rounded-full bg-primary px-7 py-3 text-sm font-semibold text-white transition-all duration-200 hover:scale-105 hover:bg-primary-dark"
        >
          Order Now
        </a>

      </div>
    </div>
  </section>

  <footer
    class="overflow-hidden bg-primary pt-26.25 text-white sm:pt-31.25 lg:pt-33.75"
  >
    <div class="border-b border-white/10">
      <Container class="py-10 sm:px-0! sm:py-12 lg:py-14">
        <div
          class="grid min-w-0 gap-10 sm:grid-cols-2 lg:grid-cols-[1.4fr_1fr_1fr_1fr] lg:gap-12"
        >
          <div class="min-w-0">
            <a
              href="/"
              aria-label="Mayflair Foods home"
              class="inline-flex"
            >
              <img
                src="/images/mayflair-logo-white.svg"
                alt="Mayflair Foods"
                width="90"
                height="50"
                class="h-auto w-19 sm:w-20"
              />
            </a>

            <p class="mt-1 text-sm text-white/80">
              Good food Only
            </p>

            <div class="mt-6">
              <h2 class="text-base font-medium">
                Cool stuffs only
              </h2>

              <p class="mt-1 text-sm text-accent">
                Subscribe to our newsletter
              </p>

              <form
                class="mt-4 flex min-w-0 max-w-md items-center rounded-full bg-white/10 p-1"
                action="#"
                method="post"
              >

                <label
                  for="newsletter-email"
                  class="sr-only"
                >
                  Your email address
                </label>

                <input
                  id="newsletter-email"
                  name="email"
                  type="email"
                  placeholder="yourname@email.com"
                  autocomplete="email"
                  required
                  class="min-w-0 flex-1 bg-transparent px-3 py-2.5 text-xs text-white outline-none placeholder:text-white/50"
                />

                <button
                  type="submit"
                  class="shrink-0 rounded-full bg-accent px-5 py-2.5 text-xs font-semibold text-foreground transition-colors hover:bg-accent-dark"
                >
                  Subscribe
                </button>

              </form>

            </div>

          </div>


          <!-- =================================================
               QUICK LINKS
               ================================================= -->

          <div class="min-w-0">

            <h2 class="text-xs font-bold uppercase tracking-wide">
              Quick Links
            </h2>

            <nav
              class="mt-4 flex flex-col gap-2"
              aria-label="Footer navigation"
            >

              {
                quickLinks.map((link) => (
                  <a
                    href={link.href}
                    class="w-fit max-w-full text-sm leading-relaxed text-white/80 transition-colors hover:text-white"
                  >
                    {link.label}
                  </a>
                ))
              }

            </nav>

          </div>


          <!-- =================================================
               HEAD OFFICE
               ================================================= -->

          <div class="min-w-0">

            <h2 class="text-xs font-bold uppercase tracking-wide">
              Head Office
            </h2>

            <address
              class="mt-4 max-w-xs text-sm not-italic leading-relaxed text-white/80"
            >
              40, Oseni Salawu Street,<br class="hidden sm:block" />
              Egan Igando, Lagos.
            </address>

          </div>


          <!-- =================================================
               CONTACT
               ================================================= -->

          <div class="min-w-0">

            <h2 class="text-xs font-bold uppercase tracking-wide">
              Contact
            </h2>

            <div class="mt-4 flex flex-col gap-2">

              <!-- Email -->

              <a
                href="mailto:info@mayflairfoods.ng"
                class="flex min-w-0 items-center gap-2 text-sm text-white/80 transition-colors hover:text-white"
              >

                <svg
                  aria-hidden="true"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.8"
                  class="h-4 w-4 shrink-0"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    d="M3 7.5 12 14l9-6.5M5 19h14a2 2 0 0 0 2-2V7a2 2 0 0 0-2-2H5a2 2 0 0 0-2 2v10a2 2 0 0 0 2 2Z"
                  ></path>
                </svg>

                <span class="truncate">
                  info@mayflairfoods.ng
                </span>

              </a>


              <!-- Phone -->

              <a
                href="tel:+2348012345678"
                class="flex items-center gap-2 text-sm text-white/80 transition-colors hover:text-white"
              >

                <svg
                  aria-hidden="true"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.8"
                  class="h-4 w-4 shrink-0"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    d="M6.6 3.5 9 3l2 5-2.5 1.8a15.4 15.4 0 0 0 5.7 5.7L16 13l5 2 .5 2.4a2 2 0 0 1-2 2.6C10.4 20 4 13.6 4 4.5a2 2 0 0 1 2.6-1Z"
                  ></path>
                </svg>

                <span>
                  08012345678
                </span>

              </a>

            </div>


            <!-- =================================================
                 SOCIAL LINKS
                 ================================================= -->

            <div class="mt-5 flex items-center gap-2">

              {
                socialLinks.map((social) => (
                  <a
                    href={social.href}
                    target="_blank"
                    rel="noopener noreferrer"
                    aria-label={social.label}
                    class="flex h-8 w-8 items-center justify-center rounded-full bg-white text-primary transition-transform hover:scale-105"
                  >

                    <!-- Instagram -->

                    {social.icon === "instagram" && (
                      <svg
                        aria-hidden="true"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2"
                        class="h-4 w-4"
                      >
                        <rect
                          width="18"
                          height="18"
                          x="3"
                          y="3"
                          rx="5"
                        />

                        <circle
                          cx="12"
                          cy="12"
                          r="4"
                        />

                        <circle
                          cx="17.5"
                          cy="6.5"
                          r="1"
                          fill="currentColor"
                          stroke="none"
                        />
                      </svg>
                    )}


                    <!-- Facebook -->

                    {social.icon === "facebook" && (
                      <svg
                        aria-hidden="true"
                        viewBox="0 0 24 24"
                        fill="currentColor"
                        class="h-4 w-4"
                      >
                        <path d="M13.5 21v-8h2.7l.4-3h-3.1V8.1c0-.9.3-1.6 1.7-1.6h1.8V3.8c-.3 0-1.4-.1-2.6-.1-2.6 0-4.4 1.6-4.4 4.5V10H7.2v3h2.8v8h3.5Z" />
                      </svg>
                    )}


                    <!-- TikTok -->

                    {social.icon === "tiktok" && (
                      <svg
                        aria-hidden="true"
                        viewBox="0 0 24 24"
                        fill="currentColor"
                        class="h-4 w-4"
                      >
                        <path d="M15.6 3c.3 1.8 1.3 3 3.4 3.2v3a7.2 7.2 0 0 1-3.4-1v6.2a5.6 5.6 0 1 1-4.8-5.5v3.1a2.5 2.5 0 1 0 1.8 2.4V3h3Z" />
                      </svg>
                    )}

                  </a>
                ))
              }

            </div>

          </div>

        </div>

      </Container>
    </div>

    <div
      class="overflow-hidden px-2 pt-8 sm:px-4 sm:pt-10 lg:px-6 lg:pt-12"
    >
      <img
        src="/images/mayflair-foods-footer.svg"
        alt=""
        aria-hidden="true"
        class="mx-auto block w-full max-w-[1200px]"
      />

    </div>

    <Container class="pb-4 pt-2 sm:pt-3">
      <p
        class="text-center text-[10px] text-white/70 sm:text-xs"
      >
        © Mayflair {currentYear}. All Rights Reserved
      </p>
    </Container>

  </footer>

</div>