---
import Button from "@/components/inside/Button.astro";
---

<div
  data-success
  hidden
  class="grid justify-items-start gap-4"
>
  <span class="grid size-14 place-items-center rounded-full bg-primary-soft text-primary">
    <svg
      width="26"
      height="26"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2.5"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
    >
      <path d="M5 12.5l4.5 4.5L19 7.5" />
    </svg>
  </span>
  <h2
    data-success-title
    tabindex="-1"
    class="font-inside text-3xl font-extrabold text-foreground outline-none"
  >
    Story received<span data-success-name></span>.
  </h2>
  <p class="max-w-[46ch] text-muted">
    Thank you. Our editors will read it and reply on WhatsApp within 3 to 5
    business days. If we publish it, your meal voucher comes with that message.
  </p>
  <div class="mt-2 flex flex-wrap gap-3">
    <Button href="/inside">Back to Inside</Button>
    <Button href="/inside/submit" variant="ghost">Write another</Button>
  </div>
</div>
