---
import { categories } from "../../data/stories";
import { site } from "../../data/site";

interface Props {
  activeCategory?: string;
}
const { activeCategory } = Astro.props;
---

<header class="inside-header max-w-svw">
  <div class="in-wrap">
    <div
      class="flex h-14 items-center gap-3 rounded-full bg-white px-4 shadow-[0_4px_18px_rgba(181,18,43,0.08)] sm:h-16"
    >
      <!-- Logo -->
      <a href="/" aria-label="Mayflair Foods home" class="shrink-0">
        <span class="hidden md:block">
          <img
            src="/images/MAYFLAIR_LOGO.svg"
            alt="Mayflair Foods"
            width="102"
            height="96"
            class="logo-lg"
          />
        </span>
        <span class="block md:hidden">
          <img
            src="/images/DP.svg"
            alt="Mayflair Foods"
            width="48"
            height="48"
            class="logo-sm"
          />
        </span>
      </a>

      <a
        href="/inside"
        class="in-badge shrink-0 rounded-full bg-foreground px-3 py-0.5 text-[0.7rem] tracking-[0.08em] uppercase"
      >
        Inside
      </a>

      <!-- Search -->
      <form
        class="relative ml-auto hidden w-full max-w-70 md:block"
        role="search"
        action="/inside"
        method="get"
      >
        <label class="sr-only" for="inside-search">Search stories</label>
        <svg
          class="pointer-events-none absolute top-1/2 left-4 -translate-y-1/2 text-muted"
          width="18"
          height="18"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          aria-hidden="true"
        >
          <circle cx="11" cy="11" r="7"></circle>
          <path d="m20 20-3.5-3.5"></path>
        </svg>
        <input
          id="inside-search"
          name="q"
          type="search"
          placeholder="Search stories"
          autocomplete="off"
          data-search
          class="h-11 w-full rounded-full bg-surface-muted pr-4 pl-11 text-sm text-foreground placeholder:text-muted"
        />
      </form>

      <!-- CTAs -->
      <div class="ml-auto flex items-center gap-2 md:ml-0">
        <a
          href={site.whatsappChannel}
          class="cta-red font-display inline-flex h-max shrink-0 items-center justify-center rounded-full bg-primary px-4 py-2 text-sm font-semibold transition-colors hover:bg-primary-dark sm:px-6 sm:py-3 sm:text-base"
        >
          Subscribe
        </a>
      </div>
    </div>
  </div>
</header>

<style>
  .inside-header {
    position: sticky;
    top: 0;
    z-index: 50;
    padding-block: 1rem 0.75rem;
    background: rgba(255, 255, 255, 0.94);
    border-bottom: 1px solid var(--mf-border-light);
  }

  /* The site's global `a { color: inherit }` and `img { height: auto }` are unlayered,
     so they beat Tailwind utilities. Colours and logo sizes live here instead. */
  .logo-lg {
    /* height: 2.5rem; */
    width: auto;
    object-fit: contain;
  }
  .logo-sm {
    height: 1.75rem;
    width: 1.75rem;
    object-fit: contain;
  }
  .in-badge {
    color: #fff;
    font-family: var(--font-inside);
    font-weight: 800;
  }
  .cta-gold {
    color: #513300;
  }
  .cta-red {
    color: #fff;
  }

  nav {
    scrollbar-width: none;
  }
  nav::-webkit-scrollbar {
    display: none;
  }

  .pill {
    flex: none;
    padding: 0.35rem 1rem;
    border: 1px solid var(--mf-border);
    border-radius: 999px;
    background: #fff;
    color: var(--mf-foreground);
    font-size: 0.9rem;
    white-space: nowrap;
    transition:
      background-color 0.15s ease,
      color 0.15s ease;
  }
  .pill:hover {
    background: var(--mf-primary-soft);
  }
  .pill.is-active {
    background: var(--mf-primary);
    border-color: var(--mf-primary);
    color: #fff;
  }
</style>
