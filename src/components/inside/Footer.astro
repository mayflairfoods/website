---
import { site } from "../../data/site";
---

<footer class="footer">
  <div class="container">
    <div class="cols">
      <div class="col brand-col">
        <p class="mark">MayFlair<small>Foods</small></p>
        <p class="tagline">{site.tagline}</p>
        <ul class="social" aria-label="Social media">
          <li><a href={site.social.instagram} aria-label="Instagram">IG</a></li>
          <li><a href={site.social.tiktok} aria-label="TikTok">TT</a></li>
          <li><a href={site.social.facebook} aria-label="Facebook">FB</a></li>
        </ul>
      </div>

      <div class="col">
        <h2>Opening hours</h2>
        <ul>
          {
            site.hours.map(([day, time]) => (
              <li>
                {day}: {time}
              </li>
            ))
          }
        </ul>
      </div>

      <div class="col">
        <h2>Quick links</h2>
        <ul>
          {
            site.quickLinks.map((l) => (
              <li>
                <a href={l.href}>{l.label}</a>
              </li>
            ))
          }
        </ul>
      </div>

      <div class="col">
        <h2>Contact</h2>
        <ul>
          <li>
            <a href={`mailto:${site.contact.email}`}>{site.contact.email}</a>
          </li>
          <li>{site.contact.address}</li>
          <li>
            <a href={`tel:${site.contact.phone}`}>{site.contact.phone}</a>
          </li>
        </ul>
      </div>
    </div>
  </div>

  <p class="wordmark" aria-hidden="true">MayFlair Foods</p>
</footer>

<style>
  .footer {
    margin-top: 5rem;
    padding-top: 4rem;
    border-radius: 40px 40px 0 0;
    background-color: var(--maroon);
    background-image: radial-gradient(
      rgba(255, 255, 255, 0.07) 1.5px,
      transparent 1.5px
    );
    background-size: 24px 24px;
    color: #fff;
    overflow: hidden;
  }

  .cols {
    display: grid;
    grid-template-columns: 1.3fr 1fr 1fr 1.2fr;
    gap: 2.5rem;
  }

  .mark {
    margin: 0 0 0.75rem;
    display: flex;
    flex-direction: column;
    font-family: var(--font-display);
    font-size: 1.6rem;
    font-weight: 800;
    line-height: 0.9;
  }
  .mark small {
    font-size: 1rem;
    color: var(--gold);
  }
  .tagline {
    max-width: 26ch;
    margin: 0 0 1.25rem;
    font-size: 0.9rem;
    opacity: 0.9;
  }

  h2 {
    margin: 0 0 1rem;
    font-family: var(--font-display);
    font-size: 0.85rem;
    font-weight: 800;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  ul {
    margin: 0;
    padding: 0;
    list-style: none;
    display: grid;
    gap: 0.6rem;
    font-size: 0.9rem;
  }
  a {
    text-decoration: none;
    opacity: 0.92;
  }
  a:hover {
    opacity: 1;
    text-decoration: underline;
  }

  .social {
    display: flex;
    gap: 0.6rem;
  }
  .social a {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background: #fff;
    color: var(--maroon);
    font-family: var(--font-display);
    font-size: 0.8rem;
    font-weight: 800;
    opacity: 1;
  }
  .footer :focus-visible {
    outline-color: #fff;
  }

  .wordmark {
    margin: 3rem 0 0;
    padding-bottom: 0.5rem;
    text-align: center;
    font-family: var(--font-display);
    font-size: clamp(3.5rem, 15vw, 12rem);
    font-weight: 800;
    line-height: 0.95;
    white-space: nowrap;
    color: #fff;
    -webkit-text-stroke: 0.04em var(--maroon-deep);
    paint-order: stroke fill;
  }

  @media (max-width: 860px) {
    .cols {
      grid-template-columns: 1fr 1fr;
    }
    .brand-col {
      grid-column: 1 / -1;
    }
  }
  @media (max-width: 520px) {
    .cols {
      grid-template-columns: 1fr;
    }
  }
</style>
