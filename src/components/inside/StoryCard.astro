---
import Eyebrow from "@/components/inside/Eyebrow.astro";
import { categoryLabel, type Story } from "@/data/stories";
import { formatStoryDate } from "@/utils/inside-date";

interface Props {
  story: Story;
}

const { story } = Astro.props;
const href = `/inside/${story.slug}`;

const zoom =
  "transition-transform duration-300 group-hover:scale-105 motion-reduce:transition-none motion-reduce:group-hover:scale-100";
---

<article
  class="group flex flex-col gap-4"
  data-card
  data-category={story.category}
  data-title={`${story.title} ${story.author} ${story.excerpt}`.toLowerCase()}
>
  <a
    href={href}
    tabindex="-1"
    aria-hidden="true"
    class="block aspect-8/5 overflow-hidden rounded-[1.25rem] bg-border-light"
  >
    {
      story.cover ? (
        <img
          src={story.cover}
          alt=""
          loading="lazy"
          width="640"
          height="400"
          class:list={["size-full object-cover", zoom]}
        />
      ) : (
        <span
          class:list={[
            "block size-full bg-linear-to-br from-border-light to-border",
            zoom,
          ]}
        />
      )
    }
  </a>

  <div class="grid gap-1.5">
    <Eyebrow>{categoryLabel(story.category)}</Eyebrow>
    <h3
      class="font-inside text-[1.3rem] leading-[1.2] font-bold text-foreground"
    >
      <a href={href} class="hover:text-primary">{story.title}</a>
    </h3>
    <p class="line-clamp-2 text-sm text-muted">{story.excerpt}</p>
    <p class="mt-1 flex flex-wrap gap-x-1.5 text-xs text-muted">
      <span>{story.author}</span>
      <span aria-hidden="true">·</span>
      <time datetime={story.publishedAt}>
        {formatStoryDate(story.publishedAt)}
      </time>
      <span aria-hidden="true">·</span>
      <span>{story.readMinutes} min read</span>
    </p>
  </div>
</article>
