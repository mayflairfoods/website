---
import { categoryLabel, type Story } from "../../data/stories";

interface Props {
  story: Story;
}
const { story } = Astro.props;
const href = `/inside/${story.slug}`;
const date = new Intl.DateTimeFormat("en-GB", {
  day: "numeric",
  month: "short",
  year: "numeric",
}).format(new Date(story.publishedAt));
---

<article
  class="card"
  data-card
  data-category={story.category}
  data-title={`${story.title} ${story.author} ${story.excerpt}`.toLowerCase()}
>
  <a class="cover" href={href} tabindex="-1" aria-hidden="true">
    {
      story.cover ? (
        <img src={story.cover} alt="" loading="lazy" width="640" height="400" />
      ) : (
        <span class="cover-ph" />
      )
    }
  </a>
  <div class="body">
    <p class="eyebrow">{categoryLabel(story.category)}</p>
    <h3><a href={href}>{story.title}</a></h3>
    <p class="excerpt">{story.excerpt}</p>
    <p class="meta">
      <span>{story.author}</span>
      <span aria-hidden="true">·</span>
      <time datetime={story.publishedAt}>{date}</time>
      <span aria-hidden="true">·</span>
      <span>{story.readMinutes} min read</span>
    </p>
  </div>
</article>

<style>
  .card {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .cover {
    display: block;
    aspect-ratio: 8 / 5;
    overflow: hidden;
    border-radius: var(--radius);
    background: var(--surface-2);
  }
  .cover img,
  .cover-ph {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.35s ease;
  }
  .cover-ph {
    background: linear-gradient(135deg, #e4dfdc, #cfc9c6);
  }
  .card:hover .cover img,
  .card:hover .cover-ph {
    transform: scale(1.04);
  }

  .body {
    display: grid;
    gap: 0.4rem;
  }
  h3 {
    margin: 0;
    font-family: var(--font-display);
    font-size: 1.3rem;
    font-weight: 700;
    line-height: 1.2;
  }
  h3 a {
    text-decoration: none;
  }
  h3 a:hover {
    color: var(--maroon);
  }
  .excerpt {
    margin: 0;
    font-size: 0.9rem;
    color: var(--muted);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
    margin: 0.25rem 0 0;
    font-size: 0.8rem;
    color: var(--muted);
  }

  @media (prefers-reduced-motion: reduce) {
    .cover img,
    .cover-ph {
      transition: none;
    }
    .card:hover .cover img,
    .card:hover .cover-ph {
      transform: none;
    }
  }
</style>
