---
import "../styles/global.css";
import { ClientRouter } from "astro:transitions";
import GoogleAnalytics from "@/components/analytics/GoogleAnalytics.astro";
import Footer from "@/components/layout/Footer.astro";

interface Props {
  title?: string;
  description?: string;
  image?: string;
  canonical?: string;
  publishedAt?: string;
  modifiedAt?: string;
  author?: string;
  noIndex?: boolean;
}

const {
  title = "The MayFlair Towncrier | Mayflair Foods",
  description = "Stories, ideas, and perspectives from our community.",
  image = "/images/og-image.jpg",
  canonical,
  publishedAt,
  modifiedAt,
  author,
  noIndex = false,
} = Astro.props;

const siteURL = Astro.site ?? new URL("https://mayflairfoods.com");
const canonicalURL = canonical
  ? new URL(canonical, siteURL).toString()
  : new URL(Astro.url.pathname, siteURL).toString();
const imageURL = new URL(image, siteURL).toString();
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#A51C32" />

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />
    {noIndex && <meta name="robots" content="noindex, nofollow" />}

    <!-- Open Graph -->
    <meta property="og:type" content="article" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:site_name" content="Mayflair Foods" />
    <meta property="og:image" content={imageURL} />
    {
      publishedAt && (
        <meta property="article:published_time" content={publishedAt} />
      )
    }
    {
      modifiedAt && (
        <meta property="article:modified_time" content={modifiedAt} />
      )
    }
    {author && <meta property="article:author" content={author} />}

    <!-- Twitter / X -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageURL} />

    <link rel="icon" href="/favicon.svg" />
    <ClientRouter />
    <slot name="head" />
    <GoogleAnalytics />
  </head>

  <body class="bg-white text-neutral-900 font-sans antialiased">
    <!-- ==========================================
         DEDICATED BLOG HEADER (MEDIUM STYLE)
    =========================================== -->
    <header
      class="sticky top-0 z-50 bg-white/95 backdrop-blur-md border-b border-neutral-100"
    >
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        {/* Top Bar: Logo, Search, Subscribe */}
        <div
          class="flex items-center justify-between h-20 border-b border-neutral-100"
        >
          {/* Logo */}
          <a href="/blog" class="flex items-center gap-2">
            <span
              class="font-bold text-xl tracking-tight text-red-700 font-serif"
              >MayFlair Foods</span
            >
          </a>

          {/* Search & Subscribe Action */}
          <div class="flex items-center gap-4">
            {/* Search Input Bar */}
            <div class="hidden sm:flex items-center relative">
              <svg
                class="absolute left-3.5 h-4 w-4 text-neutral-400"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
              </svg>
              <input
                type="text"
                placeholder="Search stories..."
                class="w-64 pl-10 pr-4 py-2 text-sm bg-neutral-100 rounded-full border-none focus:ring-2 focus:ring-red-600 focus:outline-none"
              />
            </div>

            {/* Subscribe Button */}
            <button
              onclick="document.getElementById('newsletter-section')?.scrollIntoView({ behavior: 'smooth' })"
              class="rounded-full bg-red-700 hover:bg-red-800 text-white px-5 py-2 text-sm font-medium transition-colors shadow-sm"
            >
              Subscribe
            </button>
          </div>
        </div>

        {/* Category Navigation Pills */}
        <div
          class="flex items-center gap-2 overflow-x-auto py-3 scrollbar-none"
        >
          <a
            href="/blog"
            class="px-4 py-1.5 rounded-full text-xs font-semibold bg-neutral-900 text-white whitespace-nowrap"
            >All</a
          >
          <a
            href="/blog/category/inside-life"
            class="px-4 py-1.5 rounded-full text-xs font-medium text-neutral-600 hover:bg-neutral-100 whitespace-nowrap transition-colors"
            >Inside Life</a
          >
          <a
            href="/blog/category/aluta-and-chill"
            class="px-4 py-1.5 rounded-full text-xs font-medium text-neutral-600 hover:bg-neutral-100 whitespace-nowrap transition-colors"
            >Aluta and Chill</a
          >
          <a
            href="/blog/category/community-story"
            class="px-4 py-1.5 rounded-full text-xs font-medium text-neutral-600 hover:bg-neutral-100 whitespace-nowrap transition-colors"
            >Community Story</a
          >
          <a
            href="/blog/category/events"
            class="px-4 py-1.5 rounded-full text-xs font-medium text-neutral-600 hover:bg-neutral-100 whitespace-nowrap transition-colors"
            >Events</a
          >
        </div>
      </div>
    </header>

    <main id="main-content" class="min-h-[calc(100vh-12rem)]">
      <slot />
    </main>

    <Footer />
  </body>
</html>
