---
import "../styles/global.css";
import { ClientRouter } from "astro:transitions";

import GoogleAnalytics from "@/components/analytics/GoogleAnalytics.astro";
import Header from "../components/layout/Header.astro";
import Footer from "../components/layout/Footer.astro";

interface Props {
  title?: string;
  description?: string;
  image?: string;
  noIndex?: boolean;
}

const {
  title = "Mayflair Foods | Good Food, Always.",
  description = "Good food, warm hospitality, and memorable experiences from Mayflair Foods.",
  image = "/images/og-image.jpg",
  noIndex = false,
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);

// 🔍 Check if the current page is the exact homepage root
const isHomepage = Astro.url.pathname === '/' || Astro.url.pathname === '';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no"
    />

    <meta name="theme-color" content="#A51C32" />

    <title>{title}</title>
    <meta name="description" content={description} />

    <link rel="canonical" href={canonicalURL} />

    {noIndex && <meta name="robots" content="noindex, nofollow" />}

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={image} />
    <meta property="og:site_name" content="Mayflair Foods" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={image} />

    <link rel="icon" href="/favicon.svg" />

    <!-- Astro View Transitions -->
    <ClientRouter />

    <slot name="head" />

    {isHomepage && (
      <script type="application/ld+json">
        {
          "@context": "https://schema.org",
          "@type": "FastFoodRestaurant",
          "name": "Mayflair Foods",
          "image": [
            "https://mayflairfoods.com"
          ],
          "@id": "https://mayflairfoods.com",
          "url": "https://mayflairfoods.com",
          "telephone": "+2347045816525",
          "priceRange": "₦₦",
          "servesCuisine": "Nigerian, Fast Food, Bakery, Pastries",
          "address": {
            "@type": "PostalAddress",
            "streetAddress": "Manuwa Busstop, UNEC Campus & Godfrey Okoye Back gate, Thinkers Corner",
            "addressLocality": "Enugu",
            "addressRegion": "Enugu State",
            "addressCountry": "NG"
          },
          "geo": {
            "@type": "GeoCoordinates",
            "latitude": 6.4281, 
            "longitude": 7.5052
          }
        }
      </script>
    )}

    <GoogleAnalytics />
  </head>

  <body>
    <a href="#main-content" class="sr-only focus:not-sr-only">
      Skip to content
    </a>

    <Header />

    <main id="main-content" class="min-h-[calc(100vh-4rem)]">
      <slot />
    </main>

    <Footer />
  </body>
</html>