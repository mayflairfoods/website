---
import "../styles/global.css";
import { ClientRouter } from "astro:transitions";
import GoogleAnalytics from "@/components/analytics/GoogleAnalytics.astro";

interface Props {
  title?: string;
  description?: string;
  image?: string;
  type?: "website" | "article";
  canonical?: string;
  publishedAt?: string;
  modifiedAt?: string;
  author?: string;
  noIndex?: boolean;
}

const {
  title = "Mayflair Foods | Good Food, Always.",
  description = "Good food, warm hospitality, and memorable experiences from Mayflair Foods.",
  image = "/images/mayflair-footer-mobile.webp",
  type = "website",
  canonical,
  publishedAt,
  modifiedAt,
  author,
  noIndex = false,
} = Astro.props;

const siteURL = Astro.site ?? new URL("https://mayflairfoods.com");
const canonicalURL = canonical
  ? new URL(canonical, siteURL).toString()
  : new URL(Astro.url.pathname, siteURL).toString();
const imageURL = new URL(image, siteURL).toString();
const isHomepage = Astro.url.pathname === "/" || Astro.url.pathname === "";
const isArticle = type === "article";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <!-- Viewport with zooming disabled -->
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no"
    />
    <meta name="theme-color" content="#A51C32" />

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />
    {noIndex && <meta name="robots" content="noindex, nofollow" />}

    <meta property="og:type" content={isArticle ? "article" : "website"} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:site_name" content="Mayflair Foods" />
    <meta property="og:image" content={imageURL} />

    {
      isArticle && publishedAt && (
        <meta property="article:published_time" content={publishedAt} />
      )
    }
    {
      isArticle && modifiedAt && (
        <meta property="article:modified_time" content={modifiedAt} />
      )
    }
    {isArticle && author && <meta property="article:author" content={author} />}

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageURL} />

    <link rel="icon" href="/favicon.svg" />
    <ClientRouter />
    <slot name="head" />

    {
      isHomepage && (
        <script
          type="application/ld+json"
          set:html={JSON.stringify({
            "@context": "https://schema.org",
            "@type": "FastFoodRestaurant",
            name: "Mayflair Foods",
            image: [
              new URL("/images/mayflair-storefront.jpg", siteURL).toString(),
            ],
            "@id": siteURL.toString(),
            url: siteURL.toString(),
            telephone: "+2347045816525",
            priceRange: "₦₦",
            servesCuisine: ["Nigerian", "Fast Food", "Bakery", "Pastries"],
            address: {
              "@type": "PostalAddress",
              streetAddress:
                "Manuwa Busstop, UNEC Campus & Godfrey Okoye Back Gate, Thinkers Corner",
              addressLocality: "Enugu",
              addressRegion: "Enugu State",
              addressCountry: "NG",
            },
            geo: {
              "@type": "GeoCoordinates",
              latitude: 6.4281,
              longitude: 7.5052,
            },
          })}
        />
      )
    }

    <GoogleAnalytics />
  </head>
  <body>
    <slot />
  </body>
</html>
