---
import BaseLayout from "../layouts/BaseLayout.astro";
import Container from "../components/layout/Container.astro";
import StatComponent from "@/components/shared/StatComponent.astro";

import DeliverySection from "@/components/home/DeliverySection.astro";
---

<BaseLayout
  title="Mayflair Foods | Good Food, Always."
  description="Good food, warm hospitality, and memorable experiences."
>
  <section class="relative py-20 sm:py-24 lg:py-32 isolate">
    <!-- Actual hero background -->
    <div
      class="absolute top-0 -z-10 w-full h-full bg-[url(/images/home/hero-bg.webp)] bg-cover bg-center bg-no-repeat"
    >
    </div>

    <Container>
      <div class="mx-auto max-w-3xl text-center">
        <h1
          class="text-4xl font-medium tracking-tight text-foreground sm:text-5xl lg:text-6xl"
        >
          Hungry? Say Less.
        </h1>

        <p
          class="mx-auto mt-6 max-w-2xl text-base leading-relaxed text-muted sm:text-lg"
        >
          Whether it's a quick lunch, a study break, a team hangout, or a
          well-deserved treat, there's always something good waiting at
          Mayflair.
        </p>

        <div class="mt-8 flex justify-center">
          <a
            href="https://wa.link/cpo8so"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex min-h-11 items-center justify-center rounded-full bg-primary px-6 font-display font-medium text-white! transition-colors hover:bg-primary-dark"
          >
            Order Now
          </a>
        </div>

        <div class="relative mt-10 w-full max-w-4xl">
          <img
            src="/images/home-hero.webp"
            alt="Mayflair Foods meals"
            class="mx-auto w-full object-contain"
            loading="eager"
          />
        </div>
      </div>
    </Container>
  </section>

  <section class="py-20 sm:py-24 lg:py-32">
    <Container>
      <StatComponent />

      <div
        class="flex flex-col max-w-3xl mx-auto gap-8 mt-12 items-center justify-center text-center leading-9 text-[#414141] tracking-tighter"
      >
        <p class="text-2xl">
          At Mayflair, we believe good food should feel effortless. That's why
          we focus on creating flavorful meals, delightful treats, and memorable
          experiences that fit naturally into your day, whether you're dining
          in, picking up, or ordering online.
        </p>

        <a
          href=".about"
          target="_blank"
          class="min-h-10 shrink-0 mt-4 py-2 items-center justify-center rounded-full bg-accent px-6 font-semibold text-[#584013] font-display transition-colors hover:bg-accent-dark flex"
        >
          Learn more
        </a>
      </div>
    </Container>
  </section>

  <DeliverySection />
</BaseLayout>
