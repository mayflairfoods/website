---
import InsideLayout from "../../layouts/InsideLayout.astro";
import Hero from "@/components/inside/Hero.astro";
import EditorsPick from "@/components/inside/EditorsPick.astro";
import ChannelStrip from "@/components/inside/ChannelStrip.astro";
import JournalFeed from "@/components/inside/JournalFeed.astro";
import ContributorCta from "@/components/inside/ContributorCta.astro";
import WhatsAppBar from "@/components/inside/WhatsAppBar.astro";
import { stories, videos } from "@/data/stories";

const featured = stories.find((s) => s.featured) ?? stories[0];
const feedStories = stories
  .filter((s) => s.slug !== featured.slug)
  .sort((a, b) => b.publishedAt.localeCompare(a.publishedAt));
---

<InsideLayout
  title="Inside MayFlair | Stories worth telling"
  description="The official publication, video channel and community network of MayFlair Foods."
  activeCategory="all"
>
  <Hero />
  <EditorsPick story={featured} />
  <ChannelStrip videos={videos} />
  <JournalFeed stories={feedStories} />
  <ContributorCta />
  <WhatsAppBar />
</InsideLayout>
