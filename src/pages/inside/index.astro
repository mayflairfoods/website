---
import InsideLayout from "../../layouts/InsideLayout.astro";
import { stories, videos, categoryLabel } from "../../data/stories";
import { site } from "../../data/site";
import StoryCard from "@/components/inside/StoryCard.astro";

const featured = stories.find((s) => s.featured) ?? stories[0];
const feed = stories
  .filter((s) => s.slug !== featured.slug)
  .sort((a, b) => b.publishedAt.localeCompare(a.publishedAt));

const fmt = new Intl.DateTimeFormat("en-GB", {
  day: "numeric",
  month: "short",
  year: "numeric",
});
const featuredDate = fmt.format(new Date(featured.publishedAt));
---

<InsideLayout
  title="Inside MayFlair | Stories worth telling"
  description="The official publication, video channel and community network of MayFlair Foods."
  activeCategory="all"
>
  <!-- Hero -->
  <section class="container hero-wrap">
    <div class="hero">
      <p class="hero-eyebrow">Inside MayFlair</p>
      <h1>Beyond good food, there are stories worth telling.</h1>
      <p class="hero-sub">
        The publication, video channel and community network of MayFlair Foods.
      </p>
      <div class="hero-cta">
        <a class="btn btn-gold" href={site.submitUrl}
          >Submit a story &amp; get fed</a
        >
        <a class="btn btn-outline-light" href={site.whatsappChannel}
          >Join WhatsApp channel</a
        >
      </div>
    </div>
  </section>

  <!-- Editor's pick -->
  <section class="container block" aria-labelledby="pick-title">
    <h2 id="pick-title" class="section-title">Editor's pick</h2>
    <article class="pick">
      <a
        class="pick-cover"
        href={`/inside/${featured.slug}`}
        tabindex="-1"
        aria-hidden="true"
      >
        {
          featured.cover ? (
            <img src={featured.cover} alt="" width="800" height="560" />
          ) : (
            <span class="pick-ph" />
          )
        }
      </a>
      <div class="pick-body">
        <p class="eyebrow">
          {categoryLabel(featured.category)} · {featured.campus}
        </p>
        <h3><a href={`/inside/${featured.slug}`}>{featured.title}</a></h3>
        <p class="pick-excerpt">{featured.excerpt}</p>
        <p class="pick-meta">
          By {featured.author} · <time datetime={featured.publishedAt}
            >{featuredDate}</time
          > · {featured.readMinutes} min read
        </p>
        <a class="btn btn-primary" href={`/inside/${featured.slug}`}
          >Read story</a
        >
      </div>
    </article>
  </section>

  <!-- The Channel -->
  <section class="block" aria-labelledby="channel-title">
    <div class="container head-row">
      <h2 id="channel-title" class="section-title">The Channel</h2>
      <a class="text-link" href={site.youtube}>Watch on YouTube</a>
    </div>
    <ul class="strip container" role="list">
      {
        videos.map((v) => (
          <li class={`vid vid-${v.kind}`}>
            <a href={v.href}>
              <span class="vid-thumb">
                <span class="play" aria-hidden="true">
                  <svg
                    width="22"
                    height="22"
                    viewBox="0 0 24 24"
                    fill="currentColor"
                  >
                    <path d="M8 5v14l11-7z" />
                  </svg>
                </span>
                <span class="vid-meta">{v.meta}</span>
              </span>
              <span class="vid-title">{v.title}</span>
              <span class="visually-hidden">
                {v.kind === "short" ? "Short video" : "Video"}
              </span>
            </a>
          </li>
        ))
      }
    </ul>
  </section>

  <!-- The Journal -->
  <section id="journal" class="container block" aria-labelledby="journal-title">
    <div class="head-row">
      <h2 id="journal-title" class="section-title">The Journal</h2>
      <p class="count" aria-live="polite">
        <span data-count>{feed.length}</span> stories
      </p>
    </div>

    <div class="grid" data-grid>
      {feed.map((story) => <StoryCard story={story} />)}
    </div>

    <p class="empty" data-empty hidden>
      Nothing here yet. <a href={site.submitUrl}>Write the first one.</a>
    </p>
  </section>

  <!-- Contributor CTA -->
  <section class="container block">
    <div class="contrib">
      <div>
        <p class="eyebrow">For storytellers</p>
        <h2 class="section-title">Got a story? Get published. Get fed.</h2>
        <p>
          Approved stories earn a MayFlair meal voucher, sent straight to your
          WhatsApp.
        </p>
      </div>
      <a class="btn btn-primary" href={site.submitUrl}>Submit your story</a>
    </div>
  </section>

  <!-- Mobile WhatsApp bar -->
  <aside class="wa-bar" data-wa-bar>
    <p>Story drops and hidden meal perks, first.</p>
    <a class="btn btn-gold" href={site.whatsappChannel}>Join</a>
    <button type="button" aria-label="Dismiss" data-wa-close>×</button>
  </aside>
</InsideLayout>

<script>
  const pills = document.querySelectorAll<HTMLAnchorElement>("[data-pill]");
  const cards = document.querySelectorAll<HTMLElement>("[data-card]");
  const empty = document.querySelector<HTMLElement>("[data-empty]");
  const count = document.querySelector<HTMLElement>("[data-count]");
  const search = document.querySelector<HTMLInputElement>("[data-search]");

  const params = new URLSearchParams(location.search);
  let cat = params.get("cat") ?? "all";
  let query = (params.get("q") ?? "").trim().toLowerCase();
  if (search && query) search.value = params.get("q") ?? "";

  function apply() {
    let shown = 0;
    cards.forEach((card) => {
      const matchCat = cat === "all" || card.dataset.category === cat;
      const matchQuery = !query || (card.dataset.title ?? "").includes(query);
      const on = matchCat && matchQuery;
      card.hidden = !on;
      if (on) shown++;
    });
    pills.forEach((pill) => {
      const active = pill.dataset.pill === cat;
      pill.classList.toggle("is-active", active);
      if (active) pill.setAttribute("aria-current", "true");
      else pill.removeAttribute("aria-current");
    });
    if (empty) empty.hidden = shown > 0;
    if (count) count.textContent = String(shown);
  }

  pills.forEach((pill) => {
    pill.addEventListener("click", (e) => {
      e.preventDefault();
      cat = pill.dataset.pill ?? "all";
      const url = cat === "all" ? "/inside" : `/inside?cat=${cat}`;
      history.replaceState(null, "", url);
      apply();
      document
        .getElementById("journal")
        ?.scrollIntoView({ behavior: "smooth" });
    });
  });

  search?.addEventListener("input", () => {
    query = search.value.trim().toLowerCase();
    apply();
  });
  search?.closest("form")?.addEventListener("submit", (e) => {
    e.preventDefault();
    document.getElementById("journal")?.scrollIntoView({ behavior: "smooth" });
  });

  apply();

  // Mobile WhatsApp bar
  const bar = document.querySelector<HTMLElement>("[data-wa-bar]");
  try {
    if (bar && sessionStorage.getItem("inside-wa-dismissed") === "1")
      bar.hidden = true;
  } catch {
    /* storage unavailable: leave the bar visible */
  }
  document.querySelector("[data-wa-close]")?.addEventListener("click", () => {
    if (bar) bar.hidden = true;
    try {
      sessionStorage.setItem("inside-wa-dismissed", "1");
    } catch {
      /* ignore */
    }
  });
</script>

<style>
  .block {
    margin-top: 4.5rem;
  }

  /* Hero */
  .hero-wrap {
    margin-top: 1.5rem;
  }
  .hero {
    padding: clamp(2.5rem, 6vw, 5rem) clamp(1.5rem, 5vw, 4rem);
    border-radius: var(--radius-lg);
    background-color: var(--maroon);
    background-image: radial-gradient(
      rgba(255, 255, 255, 0.08) 1.5px,
      transparent 1.5px
    );
    background-size: 22px 22px;
    color: #fff;
  }
  .hero :focus-visible {
    outline-color: #fff;
  }
  .hero-eyebrow {
    margin: 0 0 1rem;
    font-family: var(--font-display);
    font-size: 0.85rem;
    font-weight: 800;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--gold);
  }
  .hero h1 {
    max-width: 16ch;
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(2.4rem, 6.5vw, 4.6rem);
    font-weight: 800;
    line-height: 1.02;
  }
  .hero-sub {
    max-width: 46ch;
    margin: 1.25rem 0 0;
    font-size: clamp(1rem, 2vw, 1.15rem);
    opacity: 0.92;
  }
  .hero-cta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 2rem;
  }

  /* Section heads */
  .head-row {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 1.5rem;
  }
  .text-link {
    font-family: var(--font-display);
    font-weight: 700;
    color: var(--maroon);
  }
  .count {
    margin: 0;
    font-size: 0.85rem;
    color: var(--muted);
  }

  /* Editor's pick */
  .pick {
    display: grid;
    grid-template-columns: 1.15fr 1fr;
    gap: clamp(1.25rem, 4vw, 3rem);
    align-items: center;
    margin-top: 1.5rem;
    padding: 1rem;
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
  }
  .pick-cover {
    display: block;
    aspect-ratio: 10 / 7;
    overflow: hidden;
    border-radius: calc(var(--radius-lg) - 8px);
    background: var(--surface-2);
  }
  .pick-cover img,
  .pick-ph {
    width: 100%;
    height: 100%;
    display: block;
    object-fit: cover;
  }
  .pick-ph {
    background: linear-gradient(135deg, #e4dfdc, #cfc9c6);
  }
  .pick-body {
    display: grid;
    gap: 0.75rem;
    justify-items: start;
    padding: 0.5rem 1rem 0.5rem 0;
  }
  .pick-body h3 {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(1.7rem, 3.4vw, 2.6rem);
    font-weight: 800;
    line-height: 1.08;
  }
  .pick-body h3 a {
    text-decoration: none;
  }
  .pick-body h3 a:hover {
    color: var(--maroon);
  }
  .pick-excerpt {
    margin: 0;
    color: var(--muted);
  }
  .pick-meta {
    margin: 0 0 0.5rem;
    font-size: 0.85rem;
    color: var(--muted);
  }

  /* Channel strip */
  .strip {
    display: flex;
    align-items: flex-start;
    gap: 1rem;
    margin: 0 auto;
    padding: 0 0 0.75rem;
    list-style: none;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-width: thin;
  }
  .vid {
    flex: none;
    scroll-snap-align: start;
  }
  .vid-video {
    width: min(78vw, 340px);
  }
  .vid-short {
    width: min(46vw, 190px);
  }
  .vid a {
    display: grid;
    gap: 0.6rem;
    text-decoration: none;
  }
  .vid-thumb {
    position: relative;
    display: block;
    overflow: hidden;
    border-radius: var(--radius);
    background: linear-gradient(135deg, var(--maroon), var(--maroon-deep));
  }
  .vid-video .vid-thumb {
    aspect-ratio: 16 / 9;
  }
  .vid-short .vid-thumb {
    aspect-ratio: 9 / 16;
  }
  .play {
    position: absolute;
    inset: 0;
    margin: auto;
    display: grid;
    place-items: center;
    width: 56px;
    height: 56px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.95);
    color: var(--maroon);
    transition: transform 0.15s ease;
  }
  .vid a:hover .play {
    transform: scale(1.08);
  }
  .vid-meta {
    position: absolute;
    right: 0.6rem;
    bottom: 0.6rem;
    padding: 0.1rem 0.5rem;
    border-radius: 999px;
    background: rgba(0, 0, 0, 0.65);
    color: #fff;
    font-size: 0.75rem;
  }
  .vid-title {
    font-family: var(--font-display);
    font-size: 1.05rem;
    font-weight: 700;
    line-height: 1.2;
  }

  /* Journal grid */
  .grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2.5rem 1.75rem;
  }
  .empty {
    padding: 3rem 0;
    text-align: center;
    color: var(--muted);
  }
  .empty a {
    color: var(--maroon);
    font-weight: 600;
  }

  /* Contributor CTA */
  .contrib {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
    padding: clamp(1.75rem, 4vw, 3rem);
    border-radius: var(--radius-lg);
    background: var(--maroon-tint);
  }
  .contrib .section-title {
    margin-top: 0.4rem;
    max-width: 22ch;
  }
  .contrib p:not(.eyebrow) {
    margin: 0.75rem 0 0;
    max-width: 48ch;
    color: var(--muted);
  }

  /* Mobile WhatsApp bar */
  .wa-bar {
    display: none;
  }

  @media (max-width: 960px) {
    .grid {
      grid-template-columns: repeat(2, 1fr);
    }
    .pick {
      grid-template-columns: 1fr;
    }
    .pick-body {
      padding: 0.5rem;
    }
  }

  @media (max-width: 640px) {
    .block {
      margin-top: 3.25rem;
    }
    .grid {
      grid-template-columns: 1fr;
    }
    .contrib {
      flex-direction: column;
      align-items: flex-start;
    }
    .wa-bar {
      position: fixed;
      inset: auto 0.75rem 0.75rem 0.75rem;
      z-index: 60;
      display: flex;
      align-items: center;
      gap: 0.75rem;
      padding: 0.6rem 0.6rem 0.6rem 1rem;
      border-radius: 999px;
      background: var(--ink);
      color: #fff;
      box-shadow: 0 8px 24px rgba(0, 0, 0, 0.25);
    }
    .wa-bar[hidden] {
      display: none;
    }
    .wa-bar p {
      flex: 1;
      margin: 0;
      font-size: 0.8rem;
      line-height: 1.3;
    }
    .wa-bar .btn {
      min-height: 40px;
      padding-inline: 1.1rem;
    }
    .wa-bar button {
      width: 32px;
      height: 32px;
      border: 0;
      border-radius: 50%;
      background: transparent;
      color: #fff;
      font-size: 1.25rem;
      line-height: 1;
      cursor: pointer;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .play {
      transition: none;
    }
  }
</style>
