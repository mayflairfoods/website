---
import BaseLayout from "@/layouts/BaseLayout.astro";
import AboutHero from "@/components/about/AboutHero.astro";
import StoryTimeline from "@/components/about/StoryTimeline.astro";
import BrandHighlights from "@/components/about/BrandHighlights.astro";
import Values from "@/components/about/Values.astro";
import LifeAtMayflair from "@/components/about/LifeAtMayflair";
import TeamSection from "@/components/about/TeamSection.astro";
import CareersCTA from "@/components/about/CareersCTA.astro";
---

<BaseLayout
  title="About Mayflair Foods | Good Food, Always."
  description="Learn about Mayflair Foods, our story, our people, our values, and what we're building together."
>
  <main>
    <AboutHero />

    <StoryTimeline />

    <BrandHighlights />

    <Values />

    <LifeAtMayflair client:visible />

    <TeamSection />

    <CareersCTA />
  </main>
</BaseLayout>
