---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Container from "@/components/layout/Container.astro";
import ContactForm from "@/components/contact/ContactForm";
---

<BaseLayout
  title="Contact Us | Mayflair Foods"
  description="Questions, orders, feedback, or catering enquiries? Get in touch with Mayflair Foods."
>
  <!-- =====================================================
       HERO
  ====================================================== -->
  <section class="pt-16 sm:pt-20 lg:pt-24">
    <Container>
      <div class="mx-auto max-w-2xl text-center">
        <h1
          class="text-4xl font-medium leading-[1.05] tracking-tight text-foreground sm:text-5xl lg:text-6xl"
        >
          We&apos;re here&nbsp;
          <span class="bg-primary-soft px-1 text-primary">whenever</span>
          <br class="hidden sm:block" />
          &nbsp;you need us
        </h1>

        <p class="mx-auto mt-5 max-w-lg text-sm leading-relaxed text-muted">
          Questions, orders, feedback, or catering enquiries, we'd love to hear
          from you.
        </p>

        <a
          href="https://wa.link/cpo8so"
          target="_blank"
          rel="noopener noreferrer"
          class="mt-6 inline-flex min-h-10 items-center justify-center gap-2 rounded-full bg-primary px-5 text-xs font-semibold text-white transition-colors hover:bg-primary-dark"
        >
          <span
            class="flex h-5 w-5 items-center justify-center rounded-full bg-white/15"
            aria-hidden="true"
          >
            ✓
          </span>
          Let's chat on WhatsApp
        </a>
      </div>
    </Container>
  </section>

  <!-- =====================================================
       HERO IMAGE
  ====================================================== -->
  <section class="mt-10 sm:mt-12 lg:mt-14">
    <Container>
      <div class="overflow-hidden rounded-2xl sm:rounded-3xl">
        <img
          src="/images/contact-hero.jpg"
          alt="Mayflair Foods dining space"
          class="aspect-[16/7] w-full object-cover"
          loading="eager"
        />
      </div>
    </Container>
  </section>

  <!-- =====================================================
       STATS
  ====================================================== -->
  <section class="py-10 sm:py-12">
    <Container>
      <div class="grid grid-cols-2 divide-x divide-border-light sm:grid-cols-4">
        <div class="px-3 text-center sm:px-6">
          <p class="font-display text-base font-semibold text-foreground">
            10,000+
          </p>
          <p class="mt-0.5 text-[10px] text-muted">Orders Served</p>
        </div>

        <div class="px-3 text-center sm:px-6">
          <p class="font-display text-base font-semibold text-foreground">
            Made Fresh
          </p>
          <p class="mt-0.5 text-[10px] text-muted">Daily</p>
        </div>

        <div class="mt-5 border-l-0 px-3 text-center sm:mt-0 sm:px-6">
          <p class="font-display text-base font-semibold text-foreground">
            4.8/5
          </p>
          <p class="mt-0.5 text-[10px] text-muted">Orders Served</p>
        </div>

        <div class="mt-5 px-3 text-center sm:mt-0 sm:px-6">
          <p class="font-display text-base font-semibold text-foreground">
            Fast Delivery
          </p>
          <p class="mt-0.5 text-[10px] text-muted">to your location</p>
        </div>
      </div>
    </Container>
  </section>

  <!-- =====================================================
       CONTACT FORM
  ====================================================== -->
  <section class="py-14 sm:py-20 lg:py-24">
    <Container>
      <div class="grid items-start gap-10 lg:grid-cols-[0.8fr_1.2fr] lg:gap-20">
        <!-- Copy -->
        <div class="max-w-md">
          <h2
            class="text-3xl font-medium leading-tight tracking-tight text-foreground sm:text-4xl"
          >
            Tell us how we
            <br class="hidden sm:block" />
            can help
          </h2>

          <p class="mt-4 text-sm leading-relaxed text-muted">
            Whether it's feedback, a catering request, or a simple question,
            we'll get back to you as soon as we can.
          </p>

          <ul class="mt-7 space-y-3 text-xs text-muted">
            <li class="flex items-center gap-2">
              <span class="text-success" aria-hidden="true">✓</span>
              Replies within 24 hours
            </li>

            <li class="flex items-center gap-2">
              <span class="text-success" aria-hidden="true">✓</span>
              Friendly support
            </li>

            <li class="flex items-center gap-2">
              <span class="text-success" aria-hidden="true">✓</span>
              We'd love to hear from you
            </li>
          </ul>
        </div>

        <!-- React Form -->
        <ContactForm client:load />
      </div>
    </Container>
  </section>

  <!-- =====================================================
       OUTLETS
  ====================================================== -->
  <section class="py-14 sm:py-20 lg:py-24">
    <Container>
      <div class="text-center">
        <h2
          class="text-3xl font-medium tracking-tight text-foreground sm:text-4xl"
        >
          Visit any of our Outlets
        </h2>
      </div>

      <div class="mt-8 grid gap-4 sm:grid-cols-2">
        <!-- UNEC -->
        <article
          class="rounded-xl border border-border-light bg-surface-muted p-5 sm:p-6"
        >
          <div class="flex items-start gap-3">
            <span
              class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-primary-soft text-primary"
              aria-hidden="true"
            >
              •
            </span>

            <div>
              <h3 class="text-sm font-medium text-foreground">UNEC Branch</h3>

              <p class="mt-4 max-w-sm text-xs leading-relaxed text-muted">
                44 Oaks Avenue, Opposite Manuwa Bustop UNEC, Enugu
              </p>

              <a
                href="https://maps.google.com/?q=44+Oaks+Avenue+UNEC+Enugu"
                target="_blank"
                rel="noopener noreferrer"
                class="mt-4 inline-flex items-center text-xs font-semibold text-primary transition-colors hover:text-primary-dark"
              >
                View on Map
                <span class="ml-1" aria-hidden="true">→</span>
              </a>
            </div>
          </div>
        </article>

        <!-- UNEC -->
        <article
          class="rounded-xl border border-border-light bg-surface-muted p-5 sm:p-6"
        >
          <div class="flex items-start gap-3">
            <span
              class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-primary-soft text-primary"
              aria-hidden="true"
            >
              •
            </span>

            <div>
              <h3 class="text-sm font-medium text-foreground">UNEC Branch</h3>

              <p class="mt-4 max-w-sm text-xs leading-relaxed text-muted">
                44 Oaks Avenue, Opposite Manuwa Bustop UNEC, Enugu
              </p>

              <a
                href="https://maps.google.com/?q=44+Oaks+Avenue+UNEC+Enugu"
                target="_blank"
                rel="noopener noreferrer"
                class="mt-4 inline-flex items-center text-xs font-semibold text-primary transition-colors hover:text-primary-dark"
              >
                View on Map
                <span class="ml-1" aria-hidden="true">→</span>
              </a>
            </div>
          </div>
        </article>
      </div>
    </Container>
  </section>

  <!-- =====================================================
       DIRECT CONTACT
  ====================================================== -->
  <section class="bg-surface-warm py-16 sm:py-20 lg:py-24">
    <Container>
      <div class="mx-auto max-w-3xl text-center">
        <h2
          class="text-3xl font-medium tracking-tight text-foreground sm:text-4xl"
        >
          Got a question or feedback?
        </h2>

        <p class="mx-auto mt-3 max-w-lg text-xs leading-relaxed text-muted">
          Whether you have a question, feedback, or need help with an order,
          we're here to help.
        </p>
      </div>

      <div class="mx-auto mt-10 grid gap-6 sm:grid-cols-3 sm:gap-6">
        <!-- Phone -->
        <div
          class="text-center flex flex-col justify-center items-center gap-2"
        >
          <div
            class="mx-auto flex h-10 w-10 items-center justify-center rounded-full bg-primary-soft text-primary"
          >
            ☎
          </div>

          <h3 class="mt-2 text-xl font-medium">Call us directly</h3>

          <p class="text-muted">
            Speak with us directly during business hours.
          </p>

          <a href="tel:+2348012345678" class="font-medium text-primary!">
            08012345678
          </a>
        </div>

        <!-- Email -->
        <div
          class="text-center flex flex-col justify-center items-center gap-2"
        >
          <div
            class="mx-auto flex h-10 w-10 items-center justify-center rounded-full bg-primary-soft text-primary"
          >
            ✉
          </div>

          <h3 class="mt-2 text-xl font-medium">Email Support</h3>

          <p class="text-muted">For enquiries, partnerships and support.</p>

          <a
            href="mailto:hello@mayflairfoods.com"
            class="font-medium text-primary!"
          >
            hello@mayflairfoods.com
          </a>
        </div>

        <!-- WhatsApp -->
        <div
          class="text-center flex flex-col justify-center items-center gap-2"
        >
          <div
            class="mx-auto flex h-10 w-10 items-center justify-center rounded-full bg-primary-soft text-primary"
          >
            ✓
          </div>

          <h3 class="mt-1 text-xl font-medium">Chat on WhatsApp</h3>

          <p class="text-muted">Get quick answers from our team.</p>

          <a
            href="https://wa.link/cpo8so"
            target="_blank"
            rel="noopener noreferrer"
            class="mt-3 inline-flex min-h-10 items-center justify-center rounded-full bg-primary px-4 font-semibold text-white! transition-colors hover:bg-primary-dark text-sm"
          >
            Let's chat on WhatsApp
          </a>
        </div>
      </div>
    </Container>
  </section>
</BaseLayout>
