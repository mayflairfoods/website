---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Container from "@/components/layout/Container.astro";
---

<BaseLayout
  title="Page Not Found | Mayflair Foods"
  description="Looks like this page isn't available. Let's get you back to Mayflair."
  noIndex={true}
>
  <section class="flex min-h-[calc(100vh-4rem)] items-center py-20">
    <Container>
      <div class="mx-auto max-w-2xl text-center">
        <p
          class="text-sm font-semibold uppercase tracking-[0.18em] text-primary"
        >
          404
        </p>

        <h1
          class="mt-4 text-4xl font-semibold tracking-tight text-foreground sm:text-5xl"
        >
          Oops. We couldn’t find that.
        </h1>

        <p
          class="mx-auto mt-5 max-w-lg text-base leading-relaxed text-muted sm:text-lg"
        >
          Looks like the page you're looking for has moved, disappeared, or
          maybe never existed in the first place. No worries, there’s still
          plenty happening at Mayflair.
        </p>

        <div
          class="mt-8 flex flex-col items-center justify-center gap-3 sm:flex-row"
        >
          <a
            href="/"
            class="inline-flex items-center justify-center rounded-full bg-primary px-6 py-3 text-sm font-medium text-white transition-colors hover:bg-primary-dark"
          >
            Back to Mayflair
          </a>

          <a
            href="/blog"
            class="inline-flex items-center justify-center rounded-full border border-border px-6 py-3 text-sm font-medium text-foreground transition-colors hover:bg-surface-muted"
          >
            Read the Blog
          </a>
        </div>
      </div>
    </Container>
  </section>
</BaseLayout>
