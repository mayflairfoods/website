---
import { loadQuery } from "@/sanity/lib/load-query";
import { urlFor } from "@/lib/sanity-image";

import BaseLayout from "@/layouts/BaseLayout.astro";
import Container from "@/components/layout/Container.astro";
import PostBody from "@/components/blog/PostBody";

import type { Post } from "@/types/post";

export async function getStaticPaths() {
  const { data } = await loadQuery({
    query: `*[
      _type == "post" &&
      defined(slug.current)
    ]{
      "slug": slug.current
    }`,
  });

  const posts = data as Array<{
    slug: string;
  }>;

  return posts.map(({ slug }) => ({
    params: { slug },
  }));
}

const { slug } = Astro.params;

if (!slug) {
  return Astro.redirect("/404");
}

/* --------------------------------------------------
   Fetch post
-------------------------------------------------- */

const { data: post } = (await loadQuery({
  query: `*[
    _type == "post" &&
    slug.current == $slug
  ][0]{
    _id,
    title,
    "slug": slug.current,
    excerpt,
    publishedAt,
    _updatedAt,

    "author": author->{
      _id,
      name,
      image
    },

    mainImage{
      asset,
      alt
    },

    ogImage{
      asset,
      alt
    },

    "categories": coalesce(
      categories[]->{
        _id,
        title,
        "slug": slug.current
      },
      []
    ),

    "tags": coalesce(tags, []),

    body
  }`,
  params: {
    slug,
  },
})) as {
  data: Post | null;
};

if (!post) {
  return Astro.redirect("/404");
}

/* --------------------------------------------------
   Basic values
-------------------------------------------------- */

const categories = post.categories ?? [];
const tags = post.tags ?? [];

const formattedDate = post.publishedAt
  ? new Date(post.publishedAt).toLocaleDateString("en-NG", {
      year: "numeric",
      month: "long",
      day: "numeric",
    })
  : null;

const description =
  post.excerpt ||
  `Discover the story behind ${post.title} from Mayflair Foods.`;

/* --------------------------------------------------
   Images
-------------------------------------------------- */

// Main article image
const mainImageURL = post.mainImage?.asset
  ? urlFor(post.mainImage).width(1600).quality(85).url()
  : null;

// Dedicated social image → main image → global fallback
const ogImageURL = post.ogImage?.asset
  ? urlFor(post.ogImage).width(1200).height(630).fit("crop").quality(85).url()
  : mainImageURL || new URL("/images/og-image.jpg", Astro.site).toString();

/* --------------------------------------------------
   Article structured data
-------------------------------------------------- */

const blogPostSchema = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",

  headline: post.title,

  description,

  url: Astro.url.href,

  ...(post.publishedAt && {
    datePublished: post.publishedAt,
  }),

  ...(post._updatedAt && {
    dateModified: post._updatedAt,
  }),

  ...(ogImageURL && {
    image: [ogImageURL],
  }),

  author: {
    "@type": "Person",
    name: post.author?.name || "Mayflair Foods",
  },

  publisher: {
    "@type": "Organization",
    name: "Mayflair Foods",
    logo: {
      "@type": "ImageObject",
      url: new URL("/images/mayflair-logo.png", Astro.site).toString(),
    },
  },

  mainEntityOfPage: {
    "@type": "WebPage",
    "@id": Astro.url.href,
  },
};
---

<BaseLayout
  title={`${post.title} | Mayflair Foods`}
  description={description}
  image={ogImageURL}
  type="article"
  canonical={Astro.url.href}
  publishedAt={post.publishedAt}
  modifiedAt={post._updatedAt}
  author={post.author?.name}
>
  <!-- Article structured data -->
  <script
    slot="head"
    type="application/ld+json"
    set:html={JSON.stringify(blogPostSchema)}
  />

  <article>
    <!-- ==========================================
         ARTICLE HEADER
    =========================================== -->

    <header class="py-12 sm:py-16 lg:py-20">
      <Container>
        <div class="mx-auto max-w-3xl">
          <!-- Categories -->
          {
            categories.length > 0 && (
              <div class="mb-6 flex flex-wrap gap-2">
                {categories.map((category) =>
                  category.slug ? (
                    <a
                      href={`/blog/category/${category.slug}`}
                      class="rounded-full bg-primary-soft px-3 py-1 text-sm font-medium text-primary transition-colors hover:bg-primary hover:text-white"
                    >
                      {category.title}
                    </a>
                  ) : (
                    <span class="rounded-full bg-primary-soft px-3 py-1 text-sm font-medium text-primary">
                      {category.title}
                    </span>
                  ),
                )}
              </div>
            )
          }

          <!-- Title -->
          <h1
            class="text-3xl font-semibold leading-[1.08] tracking-tight text-foreground sm:text-4xl lg:text-5xl"
          >
            {post.title}
          </h1>

          <!-- Excerpt -->
          {
            post.excerpt && (
              <p class="mt-6 max-w-2xl text-lg leading-relaxed text-muted sm:text-xl">
                {post.excerpt}
              </p>
            )
          }

          <!-- Meta -->
          {
            (post.author?.name || formattedDate) && (
              <div class="mt-7 flex flex-wrap items-center gap-3 text-sm text-muted">
                {post.author?.name && <span>By {post.author.name}</span>}

                {post.author?.name && formattedDate && (
                  <span aria-hidden="true">•</span>
                )}

                {formattedDate && (
                  <time datetime={post.publishedAt}>{formattedDate}</time>
                )}
              </div>
            )
          }

          <!-- Tags -->
          {
            tags.length > 0 && (
              <div class="mt-6 flex flex-wrap gap-2">
                {tags.map((tag) => (
                  <span class="rounded-full border border-border bg-surface-muted px-3 py-1 text-sm text-muted">
                    #{tag}
                  </span>
                ))}
              </div>
            )
          }
        </div>
      </Container>
    </header>

    <!-- ==========================================
         FEATURED IMAGE
    =========================================== -->

    {
      mainImageURL && (
        <section>
          <Container>
            <figure class="mx-auto max-w-5xl overflow-hidden rounded-2xl">
              <img
                src={mainImageURL}
                alt={post.mainImage?.alt || post.title}
                width="1600"
                height="900"
                class="aspect-video w-full object-cover"
                loading="eager"
                fetchpriority="high"
              />
            </figure>
          </Container>
        </section>
      )
    }

    <!-- ==========================================
         ARTICLE BODY
    =========================================== -->

    {
      post.body && (
        <section class="py-12 sm:py-16 lg:py-20">
          <Container>
            <div class="mx-auto max-w-3xl">
              <PostBody value={post.body} />
            </div>
          </Container>
        </section>
      )
    }

    <!-- ==========================================
         BACK TO BLOG
    =========================================== -->

    <section class="border-t border-border-light">
      <Container class="py-8">
        <a
          href="/blog"
          class="inline-flex items-center gap-2 text-sm font-medium text-primary transition-colors hover:text-primary-dark"
        >
          <span aria-hidden="true">←</span>
          Back to Blog
        </a>
      </Container>
    </section>
  </article>
</BaseLayout>
