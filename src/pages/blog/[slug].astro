---
import { loadQuery } from "@/sanity/lib/load-query";
import BaseLayout from "@/layouts/BaseLayout.astro";
import Container from "@/components/layout/Container.astro";
import PostBody from "@/components/blog/PostBody";
import type { Post } from "@/types/post";

export async function getStaticPaths() {
  const { data } = await loadQuery({
    query: `*[
      _type == "post" &&
      defined(slug.current)
    ]{
      "slug": slug.current
    }`,
  });

  const posts = data as Array<{
    slug: string;
  }>;

  return posts.map(({ slug }) => ({
    params: { slug },
  }));
}

const { slug } = Astro.params;

const { data: post } = (await loadQuery({
  query: `*[
    _type == "post" &&
    slug.current == $slug
  ][0]{
    title,
    "slug": slug.current,
    publishedAt,

    "author": author->{
      name,
      image
    },

    "mainImage": {
      "url": mainImage.asset->url,
      "alt": mainImage.alt
    },

    "categories": coalesce(
      categories[]->{
        _id,
        title,
        "slug": slug.current
      },
      []
    ),

    "tags": coalesce(tags, []),

    body
  }`,
  params: {
    slug,
  },
})) as {
  data: Post | null;
};

if (!post) {
  return Astro.redirect("/404");
}

const formattedDate = post.publishedAt
  ? new Date(post.publishedAt).toLocaleDateString("en-NG", {
      year: "numeric",
      month: "long",
      day: "numeric",
    })
  : null;

const categories = post.categories ?? [];
const tags = post.tags ?? [];
---

<BaseLayout
  title={`${post.title} | Mayflair Foods`}
  description={`Read ${post.title} on Mayflair Foods.`}
  image={post.mainImage?.url}
>
  <article>
    <!-- Header -->
    <header class="py-12 sm:py-16 lg:py-20">
      <Container>
        <div class="mx-auto max-w-3xl">
          <!-- Categories -->
          {
            categories.length > 0 && (
              <div class="mb-6 flex flex-wrap gap-2">
                {categories.map((category) =>
                  category.slug ? (
                    <a
                      href={`/blog/category/${category.slug}`}
                      class="rounded-full bg-primary-soft px-3 py-1 text-sm font-medium text-primary transition-colors hover:bg-primary hover:text-white"
                    >
                      {category.title}
                    </a>
                  ) : (
                    <span class="rounded-full bg-primary-soft px-3 py-1 text-sm font-medium text-primary">
                      {category.title}
                    </span>
                  ),
                )}
              </div>
            )
          }

          <!-- Title -->
          <h1
            class="text-3xl font-semibold leading-tight tracking-tight text-foreground sm:text-4xl lg:text-5xl"
          >
            {post.title}
          </h1>

          <!-- Meta -->
          {
            (post.author?.name || formattedDate) && (
              <div class="mt-6 flex flex-wrap items-center gap-3 text-sm text-muted">
                {post.author?.name && <span>By {post.author.name}</span>}

                {post.author?.name && formattedDate && (
                  <span aria-hidden="true">•</span>
                )}

                {formattedDate && (
                  <time datetime={post.publishedAt}>{formattedDate}</time>
                )}
              </div>
            )
          }

          <!-- Tags -->
          {
            tags.length > 0 && (
              <div class="mt-6 flex flex-wrap gap-2">
                {tags.map((tag) => (
                  <span class="rounded-full border border-border bg-surface-muted px-3 py-1 text-sm text-muted">
                    #{tag}
                  </span>
                ))}
              </div>
            )
          }
        </div>
      </Container>
    </header>

    <!-- Featured Image -->
    {
      post.mainImage?.url && (
        <section>
          <Container>
            <figure class="mx-auto max-w-5xl overflow-hidden rounded-2xl">
              <img
                src={post.mainImage.url}
                alt={post.mainImage.alt || post.title}
                class="aspect-video w-full object-cover"
                loading="eager"
              />
            </figure>
          </Container>
        </section>
      )
    }

    <!-- Article -->
    {
      post.body && (
        <section class="py-10 sm:py-14 lg:py-16">
          <Container>
            <div class="mx-auto max-w-3xl">
              <PostBody value={post.body} />
            </div>
          </Container>
        </section>
      )
    }

    <!-- Back to Blog -->
    <section class="border-t border-border-light">
      <Container class="py-8">
        <a
          href="/blog"
          class="inline-flex items-center gap-2 text-sm font-medium text-primary transition-colors hover:text-primary-dark"
        >
          <span aria-hidden="true">←</span>
          Back to Blog
        </a>
      </Container>
    </section>
  </article>
</BaseLayout>
