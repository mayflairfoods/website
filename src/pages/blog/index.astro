---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Container from "@/components/layout/Container.astro";
import BlogGrid from "@/components/blog/BlogGrid";

import { loadQuery } from "@/sanity/lib/load-query";
import { urlFor } from "@/lib/sanity-image";

const { data } = await loadQuery({
  query: `
    *[
      _type == "post" &&
      defined(slug.current)
    ]
    | order(publishedAt desc) {
      title,
      "slug": slug.current,
      mainImage{
        asset,
        alt
      },
      publishedAt,

      "categories": coalesce(
        categories[]->{
          title,
          "slug": slug.current
        },
        []
      ),

      "tags": coalesce(tags, [])
    }
  `,
});

type SanityPost = {
  title: string;
  slug: string;

  mainImage?: {
    asset?: {
      _ref?: string;
      _type?: string;
    };
    alt?: string;
  };

  publishedAt?: string;

  categories?: {
    title: string;
    slug?: string;
  }[];

  tags?: string[];
};

const posts = (data as SanityPost[]).map((post) => ({
  title: post.title,
  slug: post.slug,

  image: post.mainImage?.asset
    ? urlFor(post.mainImage).width(1600).quality(85).url()
    : undefined,

  imageAlt: post.mainImage?.alt || post.title,

  publishedAt: post.publishedAt,

  categories: post.categories ?? [],
  tags: post.tags ?? [],

  // Primary category for the card
  tag: post.categories?.[0]?.title,
}));

/*
 * Collect all categories used across posts.
 */
const categories = [
  ...new Set(
    posts.flatMap((post) =>
      post.categories.map((category) => category.title).filter(Boolean),
    ),
  ),
];

/*
 * Collect all tags used across posts.
 */
const tags = [...new Set(posts.flatMap((post) => post.tags).filter(Boolean))];

const featuredPost = posts[0];

/*
 * Exclude the featured post from the grid
 * so it isn't displayed twice.
 */
const remainingPosts = posts.slice(1);
---

<BaseLayout
  title="Blog | Mayflair Foods"
  description="What's happening at Mayflair — stories, food, community, events and more."
>
  <!-- Blog Header -->
  <section class="py-12 md:py-16">
    <Container>
      <div class="max-w-2xl">
        <h1 class="text-3xl font-semibold tracking-tight md:text-4xl">Blog</h1>

        <p class="mt-2 text-sm text-muted">What's happening at Mayflair</p>
      </div>
    </Container>
  </section>

  <!-- Featured Post -->
  {
    featuredPost && (
      <section class="pb-12 md:pb-16">
        <Container>
          <a href={`/blog/${featuredPost.slug}`} class="group block">
            <div class="overflow-hidden rounded-2xl bg-surface-muted">
              {featuredPost.image && (
                <img
                  src={featuredPost.image}
                  alt={featuredPost.imageAlt}
                  width="1600"
                  height="700"
                  loading="eager"
                  fetchpriority="high"
                  class="aspect-[16/7] w-full object-cover transition-transform duration-500 group-hover:scale-[1.02]"
                />
              )}
            </div>

            <div class="mt-4">
              {featuredPost.tag && (
                <span class="inline-flex rounded-full bg-primary-soft px-3 py-1 text-xs font-medium text-primary">
                  {featuredPost.tag}
                </span>
              )}

              <h2 class="mt-3 max-w-4xl text-2xl font-medium leading-tight transition-colors group-hover:text-primary md:text-3xl">
                {featuredPost.title}
              </h2>

              {featuredPost.publishedAt && (
                <time
                  datetime={featuredPost.publishedAt}
                  class="mt-2 block text-sm text-muted"
                >
                  {new Date(featuredPost.publishedAt).toLocaleDateString(
                    "en-NG",
                    {
                      month: "long",
                      day: "numeric",
                      year: "numeric",
                    },
                  )}
                </time>
              )}
            </div>
          </a>
        </Container>
      </section>
    )
  }

  <!-- Posts -->
  <section class="pb-20">
    <Container>
      <BlogGrid
        client:load
        posts={remainingPosts}
        categories={categories}
        tags={tags}
      />
    </Container>
  </section>
</BaseLayout>
